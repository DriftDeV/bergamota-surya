+/*
+ * Poco X3 NFC: touchscreen {novatek,NVT-ts-spi} on qupv3_se0_spi (SE0 at 0x880000). SPI pins
+ * gpio49 MISO, gpio50 MOSI, gpio51 CLK, gpio52 CS (WEST TLMM tile, function qup00 = 2), reset
+ * gpio8, IRQ gpio9 (NORTH tile, same pins as sweet). 8 MHz max; driven here as software SPI mode 0.
+ * Pin numbers for the SPI lines live in the SPI_* macros below (sda/scl are unused).
+ */
+static const struct touch_board touch_surya = {
+	"SE0-SPI", 0x00880000u, 0, 0, 0,
+	0, 0, 0, 9, 8, 1080, 2400, false, true,
+};
 static const struct touch_board *tb = &touch_sweet;
 /* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
 #define GOODIX_PID_REG   0x4022u
