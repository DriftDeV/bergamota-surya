+/*
+ * Read-only: the RPMh address and VLVL table (cmd-db aux data, one u16 per
+ * level, zero padded) of an ARC resource such as "gfx.lvl", for the GPU's
+ * GMU (sweet_gpu.c), like Linux cmd_db_read_addr + cmd_db_read_aux_data.
+ * *num counts levels as KGSL rpmh_arc_cmds does. Sends nothing to RPMh.
+ */
+#define RH_ARC          3u
+int sweet_rpmh_arc_levels(const char *res, uint16_t *vals, unsigned max,
+    unsigned *num, uint32_t *address);
+
+int
+sweet_rpmh_arc_levels(const char *res, uint16_t *vals, unsigned max,
+    unsigned *num, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0, len = 0;
+
+	if (!res || !vals || !num || !address || max == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			error = EINVAL;
+			goto out;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16), off = aux + rh_db16(e + 22);
+			len = rh_db16(e + 20);
+			if (slave != RH_ARC || (addr >> 16) != RH_ARC || (len & 1u) || !rh_range(off, len)) {
+				printf("SWEET RPMH: invalid ARC entry for %s\n", res);
+				error = EINVAL;
+				goto out;
+			}
+			for (unsigned k = 0; k < max; ++k) {
+				vals[k] = k < len / 2 ? rh_db16(off + 2 * k) : 0;
+			}
+			*address = addr;
+			++matches;
+		}
+	}
+	if (matches != 1 || len < 2) {
+		printf("SWEET RPMH: %s ARC lookup matches=%u len=%u; refusing\n", res, matches, len);
+		error = ENODEV;
+		goto out;
+	}
+	for (*num = 1; *num < MIN(len / 2, max); ++*num) {
+		if (vals[*num - 1] != 0 && vals[*num] == 0) {
+			break;
+		}
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/* Generic ACTIVE payload (BCM votes, patch 0225): same transport as rh_send, N commands. */
+struct rh_command { uint32_t address, data; };
+static int
+rh_send_commands(const struct rh_command *commands, unsigned count, uint32_t wait)
+{
+	if (!commands || !count || count > rh_ncpt || count > 16 || (wait & ~((1u << count) - 1u))) {
+		return EINVAL;
+	}
+	const uint32_t enable_mask = (1u << count) - 1u;
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if (!(enabled & (1u << c))) {
+				continue;
+			}
+			uint32_t inherited = rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE);
+			for (unsigned n = 0; n < count; ++n) {
+				/* VRM has four registers; BCM addresses identify individual votes. */
+				uint32_t mask = (commands[n].address >> 16) == RH_VRM ? ~15u : ~0u;
+				if ((inherited & mask) == (commands[n].address & mask)) {
+					printf("SWEET RPMH: conflicting inherited request in TCS%u addr=%#x\n", t, inherited);
+					return EBUSY;
+				}
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	const unsigned ncmd = count;
+	printf("SWEET RPMH: TCS%u ACTIVE commands=%u wait=%#x irq-enable=%#x\n", t, count, wait, irq_en);
+	for (unsigned c = 0; c < ncmd; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, commands[c].address) ||
+		    !rh_sync(cmd + RH_DATA, commands[c].data)) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, wait) || !rh_sync(b + RH_ENABLE, enable_mask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[16] = {0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < ncmd; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: ACTIVE payload complete\n");
+	return 0;
+}
+
+
+/* Linux qcom_icc_bcm_init's cmd-db address + eight-byte bcm_db descriptor. */
+#define RH_BCM 5u
+static uint16_t
+rh_bcm_u16(uint32_t off)
+{
+	uint32_t lo = rh_read(rh_db, off & ~3u) >> (8u * (off & 3u));
+	uint32_t hi = rh_read(rh_db, (off + 1u) & ~3u) >> (8u * ((off + 1u) & 3u));
+	return (uint16_t)((lo & 0xffu) | ((hi & 0xffu) << 8));
+}
+
+int
+sweet_rpmh_bcm_info(const char *res, struct sweet_rpmh_bcm *info)
+{
+	uint32_t key[2] = { 0, 0 };
+	struct sweet_rpmh_bcm found = { 0 };
+	unsigned matches = 0, n = 0;
+	if (!res || !info) {
+		return EINVAL;
+	}
+	while (n < 8 && res[n]) {
+		key[n / 4] |= (uint32_t)(uint8_t)res[n] << (8u * (n % 4));
+		n++;
+	}
+	if (n == 0 || (n == 8 && res[n])) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			error = EINVAL;
+			goto out;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t address = rh_read(rh_db, e + 16);
+			uint32_t off = aux + rh_db16(e + 22);
+			unsigned len = rh_db16(e + 20);
+			if (slave != RH_BCM || (address >> 16) != RH_BCM || (address & 3u) ||
+			    len < 8 || !rh_range(off, len)) {
+				error = EINVAL;
+				goto out;
+			}
+			/* Aux entries need not be word-aligned. Read via aligned DB words. */
+			found.address = address;
+			found.unit = (uint32_t)rh_bcm_u16(off) | ((uint32_t)rh_bcm_u16(off + 2) << 16);
+			found.width = rh_bcm_u16(off + 4);
+			found.vcd = rh_bcm_u16(off + 6) & 0xff;
+			found.reserved = rh_bcm_u16(off + 6) >> 8;
+			found.version = rh_db16(h + 8);
+			matches++;
+		}
+	}
+	if (matches != 1) {
+		error = ENODEV;
+	} else {
+		*info = found;
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+
+/*
+ * Downstream msm_bus path 125 -> 512, live sweet FDT. Units are bytes/s.
+ * Only this client is represented here. Shared DDR votes remain held for the
+ * boot: releasing an inherited apps-DRV vote requires global ownership tracking.
+ */
+#define RH_CRYPTO_COUNT 6u
+static bool rh_crypto_held;
+static uint64_t
+rh_bcm_div(uint64_t value, uint32_t divisor)
+{
+	return value && value < divisor ? 1 : value / divisor;
+}
+
+static int
+rh_crypto_plan(const struct sweet_rpmh_bcm info[RH_CRYPTO_COUNT],
+    struct rh_command commands[RH_CRYPTO_COUNT], uint32_t *wait)
+{
+	/* Order before sorting: CE0, SN11, SN0, SH0, MC0, ACV. */
+	static const uint16_t widths[] = { 8, 16, 16, 16, 4, 0 };
+	static const uint16_t ports[] = { 1, 1, 1, 2, 2, 0 };
+	const uint64_t average = 393600000ULL, peak = 3936000000ULL;
+	uint8_t domains[RH_CRYPTO_COUNT];
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		const struct sweet_rpmh_bcm *b = &info[i];
+		if (b->version != 0x1000 || b->reserved || !b->unit || b->vcd >= 16 ||
+		    (b->address >> 16) != RH_BCM || (b->address & 3u) ||
+		    (i < 5 && (!b->width || b->width > 64)) ||
+		    (i == 5 && (b->width != 0 || b->unit != 1))) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < i; ++j) {
+			if (info[j].address == b->address) {
+				return EINVAL;
+			}
+		}
+		uint64_t x = 0, y = 8; /* BCM ACV: apps bit, msm_bus_arb_rpmh.c. */
+		if (i < 5) {
+			x = rh_bcm_div(rh_bcm_div(average * b->width, widths[i] * ports[i]), b->unit);
+			y = rh_bcm_div(rh_bcm_div(peak * b->width, widths[i]), b->unit);
+		}
+		x = MIN(x, 0x3fffULL);
+		y = MIN(y, 0x3fffULL);
+		commands[i].address = b->address;
+		commands[i].data = (1u << 29) | ((uint32_t)x << 14) | (uint32_t)y;
+		domains[i] = b->vcd;
+	}
+	/* All commands for a VCD must precede that VCD's final commit. */
+	for (unsigned i = 1; i < RH_CRYPTO_COUNT; ++i) {
+		unsigned j = i;
+		while (j && domains[j] < domains[j - 1]) {
+			uint8_t domain = domains[j];
+			domains[j] = domains[j - 1]; domains[j - 1] = domain;
+			struct rh_command cmd = commands[j];
+			commands[j] = commands[j - 1]; commands[j - 1] = cmd;
+			j--;
+		}
+	}
+	*wait = 0;
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		if (i + 1 == RH_CRYPTO_COUNT || domains[i] != domains[i + 1]) {
+			commands[i].data |= 1u << 30;
+			*wait |= 1u << i;
+		}
+	}
+	return 0;
+}
+
+int
+sweet_rpmh_crypto_bw(void)
+{
+	static const char *const names[] = { "CE0", "SN11", "SN0", "SH0", "MC0", "ACV" };
+	struct sweet_rpmh_bcm info[RH_CRYPTO_COUNT];
+	struct rh_command commands[RH_CRYPTO_COUNT];
+	uint32_t wait;
+	/* Read/validate every descriptor before touching any TCS. */
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		int error = sweet_rpmh_bcm_info(names[i], &info[i]);
+		if (error) {
+			return error;
+		}
+	}
+	int error = rh_crypto_plan(info, commands, &wait);
+	if (error) {
+		return error;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		error = EIO;
+		goto out;
+	}
+	if (rh_crypto_held) {
+		goto out;
+	}
+	error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		printf("SWEET RPMH: crypto BCM[%u] addr=%#x data=%#x wait=%u\n",
+		    i, commands[i].address, commands[i].data, !!(wait & (1u << i)));
+	}
+	error = rh_send_commands(commands, RH_CRYPTO_COUNT, wait);
+	if (!error) {
+		rh_crypto_held = true;
+		printf("SWEET RPMH: crypto bandwidth held until reset\n");
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
