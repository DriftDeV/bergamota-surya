+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Poll until (reg & mask) == want; true on success. */
+static bool
+gpu_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i <= us; i++) {
+		if ((gpu_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* clk_branch2 enable: set CLK_ENABLE, wait for CLK_OFF to drop. */
+static bool
+gpu_branch_on(vm_offset_t base, uint32_t off, const char *name)
+{
+	gpu_wr(base, off, gpu_rd(base, off) | CBCR_CLK_ENABLE);
+	bool ok = gpu_poll(base, off, CBCR_CLK_OFF, 0, 200);
+	printf("SWEET GPU: enable %-12s CBCR 0x%08x%s\n", name, gpu_rd(base, off),
+	    ok ? "" : " (still off after 200 us)");
+	return ok;
+}
+
+/* Returns true when the CX domain and the GMU clocks are up. */
+static bool
+gpu_report(uint32_t *gx_gdscr)
+{
+	uint32_t cfg_ahb, cx_gdscr, cbcr[CC_N];
+
+	cfg_ahb = gpu_rd(gcc, GCC_GPU_CFG_AHB_CBCR);
+	printf("SWEET GPU: GCC cfg_ahb 0x%08x memnoc_gfx 0x%08x snoc_dvm_gfx 0x%08x ddrss_gpu_axi 0x%08x gpll0 vote 0x%08x\n",
+	    cfg_ahb, gpu_rd(gcc, GCC_GPU_MEMNOC_GFX_CBCR), gpu_rd(gcc, GCC_GPU_SNOC_DVM_CBCR),
+	    gpu_rd(gcc, GCC_DDRSS_GPU_AXI_CBCR), gpu_rd(gcc, GCC_GPU_GPLL0_VOTE));
+	if (cfg_ahb & CBCR_CLK_OFF) {
+		printf("SWEET GPU: GPU CC config clock off; GPU CC not read\n");
+		return false;
+	}
+	cx_gdscr = gpu_rd(cc, GPUCC_CX_GDSCR);
+	*gx_gdscr = gpu_rd(cc, GPUCC_GX_GDSCR);
+	printf("SWEET GPU: GDSC cx 0x%08x (%s, hw status 0x%08x) gx 0x%08x (%s)\n",
+	    cx_gdscr, (cx_gdscr & GDSC_PWR_ON) ? "on" : "off", gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL),
+	    *gx_gdscr, (*gx_gdscr & GDSC_PWR_ON) ? "on" : "off");
+	printf("SWEET GPU: GMU RCG cmd 0x%08x cfg 0x%08x\n",
+	    gpu_rd(cc, GPUCC_GMU_CMD_RCGR), gpu_rd(cc, GPUCC_GMU_CFG_RCGR));
+	for (unsigned i = 0; i < CC_N; i++) {
+		cbcr[i] = gpu_rd(cc, gpucc_cbcr[i].off);
+		printf("SWEET GPU: clk %-12s CBCR 0x%08x (%s)\n", gpucc_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* GMU registers need the CX GDSC and the GMU, AHB and XO clocks. */
+	return (cx_gdscr & GDSC_PWR_ON) && !(cbcr[CC_AHB] & CBCR_CLK_OFF) &&
+	       !(cbcr[CC_CX_GMU] & CBCR_CLK_OFF) && !(cbcr[CC_CXO] & CBCR_CLK_OFF);
+}
+
+static void
+gpu_report_gmu(uint32_t gx_gdscr)
+{
+	if (gmu == 0 && (gmu = ml_io_map(GMU_PA, GMU_SIZE)) == 0) {
+		printf("SWEET GPU: GMU map failed\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(gmu_regs) / sizeof(gmu_regs[0]); i++) {
+		printf("SWEET GPU: GMU %-24s 0x%08x\n", gmu_regs[i].name, gpu_rd(gmu, GMU_REG(gmu_regs[i].reg)));
+	}
+	/* The GPU core is in the GX domain, which the GMU normally controls. */
+	if (!(gx_gdscr & GDSC_PWR_ON) || (gpu_rd(cc, gpucc_cbcr[CC_GX_GFX3D].off) & CBCR_CLK_OFF)) {
+		printf("SWEET GPU: GX domain off; GPU core not read\n");
+		return;
+	}
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (gpu == 0) {
+		return;
+	}
+	printf("SWEET GPU: RBBM_STATUS 0x%08x CP_SQE_INSTR_BASE 0x%08x\n",
+	    gpu_rd(gpu, A6XX_RBBM_STATUS * 4), gpu_rd(gpu, A6XX_CP_SQE_INSTR_BASE_LO * 4));
+}
+
+/*
+ * CX domain + GMU clocks, in the order of the phone's kernel: GMU runtime
+ * resume enables the CX GDSC (gdsc_enable with hw-ctrl-addr status), then
+ * the gmu_clk rate is set and gmu_clk, cxo_clk, axi_clk, memnoc_clk are
+ * enabled. The CX rail's LOW_SVS vote is already satisfied while the CPUs,
+ * UFS and USB run, and the GX domain stays with the GMU.
+ */
+static bool
+gpu_power_cx(void)
+{
+	uint32_t v = gpu_rd(cc, GPUCC_CX_GDSCR);
+
+	if (v & GDSC_HW_CONTROL) {
+		printf("SWEET GPU: CX GDSC under HW control (0x%08x); not touched\n", v);
+		return false;
+	}
+	if (!(v & GDSC_PWR_ON)) {
+		v = (v & ~GDSC_CLK_DIS_WAIT_MASK) | GDSC_CLK_DIS_WAIT(8);
+		gpu_wr(cc, GPUCC_CX_GDSCR, v);
+		gpu_wr(cc, GPUCC_CX_GDSCR, v & ~GDSC_SW_COLLAPSE);
+		delay(1);       /* 8 XO cycles before the status bit is valid */
+		if (!gpu_poll(cc, GPUCC_CX_GDS_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, GDSC_TIMEOUT_US) &&
+		    !gpu_poll(cc, GPUCC_CX_GDS_HW_CTRL, GDSC_PWR_ON, GDSC_PWR_ON, GDSC_TIMEOUT_US)) {
+			printf("SWEET GPU: CX GDSC enable timed out: gdscr 0x%08x hw status 0x%08x\n",
+			    gpu_rd(cc, GPUCC_CX_GDSCR), gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL));
+			return false;
+		}
+	}
+	printf("SWEET GPU: CX GDSC on: gdscr 0x%08x hw status 0x%08x\n",
+	    gpu_rd(cc, GPUCC_CX_GDSCR), gpu_rd(cc, GPUCC_CX_GDS_HW_CTRL));
+
+	gpu_wr(gcc, GCC_GPU_GPLL0_VOTE, gpu_rd(gcc, GCC_GPU_GPLL0_VOTE) | GCC_GPU_GPLL0 | GCC_GPU_GPLL0_DIV);
+	delay(10);      /* BRANCH_HALT_DELAY: no status bit */
+
+	gpu_wr(cc, GPUCC_GMU_CFG_RCGR, GMU_RCG_CFG_200MHZ);
+	gpu_wr(cc, GPUCC_GMU_CMD_RCGR, gpu_rd(cc, GPUCC_GMU_CMD_RCGR) | RCG_CMD_UPDATE);
+	if (!gpu_poll(cc, GPUCC_GMU_CMD_RCGR, RCG_CMD_UPDATE, 0, 500)) {
+		printf("SWEET GPU: GMU RCG update timed out: cmd 0x%08x cfg 0x%08x\n",
+		    gpu_rd(cc, GPUCC_GMU_CMD_RCGR), gpu_rd(cc, GPUCC_GMU_CFG_RCGR));
+		return false;
+	}
+	printf("SWEET GPU: GMU RCG 200 MHz: cmd 0x%08x cfg 0x%08x\n",
+	    gpu_rd(cc, GPUCC_GMU_CMD_RCGR), gpu_rd(cc, GPUCC_GMU_CFG_RCGR));
+
+	bool ok = gpu_branch_on(cc, gpucc_cbcr[CC_AHB].off, "ahb");
+	ok &= gpu_branch_on(cc, gpucc_cbcr[CC_CXO].off, "cxo");
+	ok &= gpu_branch_on(cc, gpucc_cbcr[CC_CX_GMU].off, "cx_gmu");
+	/* Bus clocks: their status may lag the vote; logged, not required. */
+	gpu_branch_on(gcc, GCC_GPU_MEMNOC_GFX_CBCR, "memnoc_gfx");
+	gpu_branch_on(gcc, GCC_DDRSS_GPU_AXI_CBCR, "ddrss_gpu_axi");
+	return ok;
+}
+
+/* Needs the CX GDSC and GCC_GPU_MEMNOC_GFX_CLK (DT kgsl_smmu clocks). */
+static void
+gpu_smmu_probe(void)
+{
+	if (gpu_rd(gcc, GCC_GPU_MEMNOC_GFX_CBCR) & CBCR_CLK_OFF) {
+		printf("SWEET GPU: SMMU clock off; SMMU not read\n");
+		return;
+	}
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu == 0) {
+		printf("SWEET GPU: SMMU map failed\n");
+		return;
+	}
+	uint32_t id0 = gpu_rd(smmu, SMMU_IDR0), id1 = gpu_rd(smmu, SMMU_IDR1);
+	unsigned nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	uint32_t page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	uint32_t cb_base = page << (((id1 >> 28) & 7) + 1);
+	printf("SWEET GPU: SMMU sCR0 0x%08x IDR0 0x%08x IDR1 0x%08x IDR2 0x%08x: %u SMRs, %u CBs, page 0x%x, CBs at +0x%x\n",
+	    gpu_rd(smmu, SMMU_sCR0), id0, id1, gpu_rd(smmu, SMMU_IDR2), nsmr, ncb, page, cb_base);
+	for (unsigned i = 0; i < nsmr && SMMU_S2CR(i) < page; i++) {
+		uint32_t smr = gpu_rd(smmu, SMMU_SMR(i)), s2cr = gpu_rd(smmu, SMMU_S2CR(i));
+		if (smr || s2cr) {
+			printf("SWEET GPU: SMMU SMR%-2u 0x%08x (%s id 0x%x mask 0x%x) S2CR 0x%08x (type %u cb %u)\n",
+			    i, smr, (smr & (1u << 31)) ? "valid" : "invalid", smr & 0x7fff, (smr >> 16) & 0x7fff,
+			    s2cr, (s2cr >> 16) & 3, s2cr & 0xff);
+		}
+	}
+	for (unsigned i = 0; i < ncb; i++) {
+		uint32_t cb = cb_base + i * page;
+		if (cb + page > SMMU_SIZE || page + SMMU_CBAR(i) >= cb_base) {
+			printf("SWEET GPU: SMMU CB%u outside the 0x%x mapping\n", i, SMMU_SIZE);
+			break;
+		}
+		printf("SWEET GPU: SMMU CB%-2u CBAR 0x%08x SCTLR 0x%08x TCR 0x%08x TTBR0 0x%08x%08x FSR 0x%08x\n",
+		    i, gpu_rd(smmu, page + SMMU_CBAR(i)), gpu_rd(smmu, cb + SMMU_CB_SCTLR),
+		    gpu_rd(smmu, cb + SMMU_CB_TCR), gpu_rd(smmu, cb + SMMU_CB_TTBR0_HI),
+		    gpu_rd(smmu, cb + SMMU_CB_TTBR0_LO), gpu_rd(smmu, cb + SMMU_CB_FSR));
+	}
+}
+
+/* Write and read back the first and last words of ITCM and DTCM, then clear them. */
+static void
+gpu_tcm_test(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t    base;
+	} tcm[] = { { "ITCM", GMU_ITCM }, { "DTCM", GMU_DTCM } };
+	uint32_t sysreset = gpu_rd(gmu, GMU_CM3_SYSRESET);
+
+	if (sysreset != 1) {
+		printf("SWEET GPU: CM3_SYSRESET 0x%08x, GMU core not held in reset; TCM not written\n", sysreset);
+		return;
+	}
+	for (unsigned t = 0; t < sizeof(tcm) / sizeof(tcm[0]); t++) {
+		uint32_t offs[] = { 0, 4, 8, 12, GMU_TCM_SIZE - 4 }, bad = 0;
+		for (unsigned i = 0; i < sizeof(offs) / sizeof(offs[0]); i++) {
+			gpu_wr(gmu, tcm[t].base + offs[i], 0x5ee70000u | (t << 12) | offs[i]);
+		}
+		for (unsigned i = 0; i < sizeof(offs) / sizeof(offs[0]); i++) {
+			uint32_t want = 0x5ee70000u | (t << 12) | offs[i], got = gpu_rd(gmu, tcm[t].base + offs[i]);
+			if (got != want) {
+				printf("SWEET GPU: %s +0x%04x wrote 0x%08x read 0x%08x\n", tcm[t].name, offs[i], want, got);
+				bad++;
+			}
+			gpu_wr(gmu, tcm[t].base + offs[i], 0);
+		}
+		printf("SWEET GPU: %s write/readback %s\n", tcm[t].name, bad ? "FAILED" : "ok");
+	}
+}
+
+/* PDC TCS command n of the bank starting at msgid0: MSGID, ADDR, DATA. */
+static void
+pdc_tcs_cmd(vm_offset_t cfg, uint32_t msgid0, unsigned n, uint32_t addr, uint32_t data)
+{
+	uint32_t r = msgid0 + n * PDC_CMD_OFFSET;
+	gpu_wr(cfg, 4u * r, 0x10108);
+	gpu_wr(cfg, 4u * (r + 1), addr);
+	gpu_wr(cfg, 4u * (r + 2), data);
+}
+
+/*
+ * _load_gmu_rpmh_ucode for the a618: RSC handshake and sequencer, PDC
+ * sequencer, and the TCS1/TCS3 RPMh commands the PDC sends on GPU power
+ * down and up (0x30010/0x30000/0x30090 are the RPMh addresses KGSL uses on
+ * this target; the a618 differs from the a630 in the third address and in
+ * TCS3's second data word).
+ */
+static bool
+gpu_gmu_rpmh_ucode(void)
+{
+	static const uint32_t rsc_seq[] = { 0xa7a506a0, 0xa1e6a6e7, 0xa2e081e1, 0xe9a982e2, 0x0020e8a8 };
+	static const uint32_t pdc_seq[] = { 0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+	vm_offset_t cfg = ml_io_map(PDC_CFG_PA, PDC_SIZE), seq = ml_io_map(PDC_SEQ_PA, PDC_SIZE);
+
+	if (cfg == 0 || seq == 0) {
+		printf("SWEET GPU: PDC map failed\n");
+		return false;
+	}
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_RSC_STATUS0_DRV0), 1u << 24);    /* no SDE clock gating */
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_PDC_SLAVE_ID_DRV0), 1);
+	for (unsigned i = 0; i < 3; i++) {
+		gpu_wr(gmu, GMU_RSCC_REG(RSCC_HIDDEN_TCS_CMD0_DATA + i * RSC_CMD_OFFSET), i == 2 ? 0x80000000u : 0);
+		gpu_wr(gmu, GMU_RSCC_REG(RSCC_HIDDEN_TCS_CMD0_ADDR + i * RSC_CMD_OFFSET), 0);
+	}
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_OVERRIDE_START_ADDR), 0);
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_PDC_SEQ_START_ADDR), 0x4520);
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_PDC_MATCH_VALUE_LO), 0x4510);
+	gpu_wr(gmu, GMU_RSCC_REG(RSCC_PDC_MATCH_VALUE_HI), 0x4514);
+	for (unsigned i = 0; i < sizeof(rsc_seq) / sizeof(rsc_seq[0]); i++) {
+		gpu_wr(gmu, GMU_RSCC_REG(RSCC_SEQ_MEM_0_DRV0 + i), rsc_seq[i]);
+	}
+	for (unsigned i = 0; i < sizeof(pdc_seq) / sizeof(pdc_seq[0]); i++) {
+		gpu_wr(seq, 4u * i, pdc_seq[i]);                        /* PDC_GPU_SEQ_MEM_0 + i */
+	}
+	gpu_wr(cfg, 4u * PDC_GPU_TCS1_CMD_ENABLE_BANK, 7);
+	gpu_wr(cfg, 4u * PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK, 0);
+	gpu_wr(cfg, 4u * PDC_GPU_TCS1_CONTROL, 0);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS1_CMD0_MSGID, 0, 0x30010, 1);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS1_CMD0_MSGID, 1, 0x30000, 0);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS1_CMD0_MSGID, 2, 0x30090, 0);
+	gpu_wr(cfg, 4u * PDC_GPU_TCS3_CMD_ENABLE_BANK, 7);
+	gpu_wr(cfg, 4u * PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK, 0);
+	gpu_wr(cfg, 4u * PDC_GPU_TCS3_CONTROL, 0);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS3_CMD0_MSGID, 0, 0x30010, 2);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS3_CMD0_MSGID, 1, 0x30000, 2);
+	pdc_tcs_cmd(cfg, PDC_GPU_TCS3_CMD0_MSGID, 2, 0x30090, 3);
+	gpu_wr(cfg, 4u * PDC_GPU_SEQ_START_ADDR, 0);
+	gpu_wr(cfg, 4u * PDC_GPU_ENABLE_PDC, PDC_ENABLE_REG_VALUE);
+	return true;
+}
+
+static void
+gpu_smmu_faults(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu == 0) {
+		return;
+	}
+	printf("SWEET GPU: SMMU sGFSR 0x%08x sGFSYNR0 0x%08x sGFSYNR1 0x%08x sGFSYNR2 0x%08x sGFAR 0x%08x%08x\n",
+	    gpu_rd(smmu, SMMU_sGFSR), gpu_rd(smmu, SMMU_sGFSYNR0), gpu_rd(smmu, SMMU_sGFSYNR1),
+	    gpu_rd(smmu, SMMU_sGFSYNR2), gpu_rd(smmu, SMMU_sGFAR_HI), gpu_rd(smmu, SMMU_sGFAR_LO));
+}
+
+static void
+gpu_gmu_state(const char *when)
+{
+	printf("SWEET GPU: GMU %s: FW_INIT_RESULT 0x%08x SYSRESET 0x%08x GMU2HOST_INFO 0x%08x AO_HOST_INT 0x%08x RPMH_POWER_STATE 0x%08x HFI_CTRL_STATUS 0x%08x\n",
+	    when, gpu_rd(gmu, GMU_CM3_FW_INIT_RESULT), gpu_rd(gmu, GMU_CM3_SYSRESET),
+	    gpu_rd(gmu, GMU_GMU2HOST_INTR_INFO), gpu_rd(gmu, GMU_AO_HOST_INTERRUPT_STATUS),
+	    gpu_rd(gmu, GMU_REG(0x1f8ec)), gpu_rd(gmu, GMU_REG(0x1f980)));
+}
+
+static vm_offset_t gmem;        /* kernel VA of the (non-cacheable) GMU memory block */
+static uint64_t gmem_pa;
+static uint32_t hfi_seq;
+
+static uint32_t gm_rd(uint32_t off) { return gpu_rd(gmem, off); }
+static void gm_wr(uint32_t off, uint32_t v) { gpu_wr(gmem, off, v); }
+
+static void
+gm_wr64(uint32_t off, uint64_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(gmem + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Map GMU VA va (4 KiB pages, 0x60000000-0x603fffff) to gmem + off. */
+static void
+gm_map(uint32_t va, uint32_t off, uint32_t size)
+{
+	for (uint32_t done = 0; done < size; done += 0x1000) {
+		uint32_t v = va + done;
+		uint32_t l3 = ((v >> 21) & 0x1ff) == ((GMU_VA_DUMMY >> 21) & 0x1ff) ? GMEM_L3A : GMEM_L3B;
+		gm_wr64(l3 + 8 * ((v >> 12) & 0x1ff), (gmem_pa + off + done) | PTE_PAGE_NC);
+	}
+}
+
+static bool
+gpu_gmem_alloc(void)
+{
+	vm_offset_t kva;
+
+	if (kmem_alloc_contig(kernel_map, &kva, GMEM_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: no contiguous GMU memory\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (!pn) {
+		return false;
+	}
+	gmem_pa = ptoa_64(pn);
+	for (unsigned i = 0; i < GMEM_SIZE / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	flush_dcache64((addr64_t)gmem_pa, GMEM_SIZE, TRUE);    /* pmap_sync_wimg did this too */
+	gmem = kva;
+	/* 32-bit VA, 4 KiB granule: walks start at level 1 (VA[31:30]). */
+	gm_wr64(GMEM_L1 + 8 * (GMU_VA_HFI >> 30), (gmem_pa + GMEM_L2) | PTE_TABLE);
+	gm_wr64(GMEM_L2 + 8 * ((GMU_VA_DUMMY >> 21) & 0x1ff), (gmem_pa + GMEM_L3A) | PTE_TABLE);
+	gm_wr64(GMEM_L2 + 8 * ((GMU_VA_DUMP >> 21) & 0x1ff), (gmem_pa + GMEM_L3B) | PTE_TABLE);
+	gm_map(GMU_VA_DUMMY, GMEM_DUMMY, 0x1000);
+	gm_map(GMU_VA_HFI, GMEM_HFI, GMEM_HFI_SIZE);
+	gm_map(GMU_VA_DUMP, GMEM_DUMP, GMEM_DUMP_SIZE);
+	gm_map(GMU_VA_LOG, GMEM_LOG, 0x1000);
+	printf("SWEET GPU: GMU memory at 0x%llx: dummy 0x%08x, HFI 0x%08x, dump 0x%08x, log 0x%08x\n",
+	    gmem_pa, GMU_VA_DUMMY, GMU_VA_HFI, GMU_VA_DUMP, GMU_VA_LOG);
+	return true;
+}
+
+static bool
+smmu_sync(vm_offset_t base, uint32_t sync, uint32_t status)
+{
+	gpu_wr(base, sync, 0);
+	if (!gpu_poll(base, status, 1, 0, 10000)) {
+		printf("SWEET GPU: SMMU TLB sync timed out (0x%x)\n", sync);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * arm_smmu_test_smr_masks on every SMR: the ID field, then the MASK field,
+ * written without SMR_VALID (no stream is matched) and read back, then 0.
+ * Linux depends on this readback on this SMMU, so SMRs that stay 0 here
+ * mean something else owns them.
+ */
+static void
+gpu_smmu_smr_test(vm_offset_t smmu)
+{
+	unsigned nsmr = gpu_rd(smmu, SMMU_IDR0) & 0xff;
+
+	for (unsigned i = 0; i < nsmr && SMMU_S2CR(i) < SMMU_PAGE; i++) {
+		uint32_t before = gpu_rd(smmu, SMMU_SMR(i)), id, mask;
+		if (before & SMR_VALID) {
+			printf("SWEET GPU: SMR%u in use (0x%08x); not tested\n", i, before);
+			continue;
+		}
+		gpu_wr(smmu, SMMU_SMR(i), 0x7fffu);
+		id = gpu_rd(smmu, SMMU_SMR(i));
+		gpu_wr(smmu, SMMU_SMR(i), 0x7fffu << 16);
+		mask = gpu_rd(smmu, SMMU_SMR(i));
+		gpu_wr(smmu, SMMU_SMR(i), before);
+		printf("SWEET GPU: SMR%u test: id bits 0x%08x mask bits 0x%08x, restored 0x%08x\n",
+		    i, id, mask, gpu_rd(smmu, SMMU_SMR(i)));
+	}
+}
+
+enum { SMMU_FAILED, SMMU_UNROUTED, SMMU_ROUTED };
+
+/*
+ * arm_smmu_write_sme (S2CR, then SMR), then read both back with the
+ * global fault status, which reports configuration faults (GCFGFRE).
+ */
+static void
+smmu_write_sme(vm_offset_t smmu, unsigned idx, uint32_t s2cr, uint32_t smr, const char *what)
+{
+	uint32_t gfsr0 = gpu_rd(smmu, SMMU_sGFSR);
+
+	gpu_wr(smmu, SMMU_sGFSR, gfsr0);                       /* write 1 to clear */
+	gpu_wr(smmu, SMMU_S2CR(idx), s2cr);
+	gpu_wr(smmu, SMMU_SMR(idx), smr);
+	uint32_t gfsr = gpu_rd(smmu, SMMU_sGFSR);
+	printf("SWEET GPU: SMR%u (%s) wrote S2CR 0x%08x SMR 0x%08x, reads S2CR 0x%08x SMR 0x%08x; sGFSR 0x%08x -> 0x%08x sGFSYNR0 0x%08x\n",
+	    idx, what, s2cr, smr, gpu_rd(smmu, SMMU_S2CR(idx)), gpu_rd(smmu, SMMU_SMR(idx)),
+	    gfsr0, gfsr, gpu_rd(smmu, SMMU_sGFSYNR0));
+}
+
+/* Context bank GMU_CB translating stream IDs 4 and 5 through the gmem tables. */
+static int
+gpu_smmu_setup(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+
+	if (smmu == 0) {
+		return SMMU_FAILED;
+	}
+	if (gpu_rd(smmu, SMMU_CB(GMU_CB) + SMMU_CB_SCTLR) != 0 ||
+	    ((gpu_rd(smmu, SMMU_SMR(GMU_SMR_IDX)) | gpu_rd(smmu, SMMU_SMR(GMU_SMR_IDX + 1)) |
+	    gpu_rd(smmu, SMMU_SMR(GMU_SMR_IDX + 2))) & SMR_VALID)) {
+		printf("SWEET GPU: SMMU CB%u / SMR%u-%u already in use; not touched\n", GMU_CB, GMU_SMR_IDX, GMU_SMR_IDX + 2);
+		return SMMU_FAILED;
+	}
+	/* qsmmuv2_device_reset: impl-defs while the micro-MMU is halted. */
+	gpu_wr(smmu, SMMU_MICRO_MMU_CTRL, gpu_rd(smmu, SMMU_MICRO_MMU_CTRL) | MICRO_MMU_HALT_REQ);
+	if (!gpu_poll(smmu, SMMU_MICRO_MMU_CTRL, MICRO_MMU_IDLE, MICRO_MMU_IDLE, 30000)) {
+		printf("SWEET GPU: SMMU did not halt (0x%08x)\n", gpu_rd(smmu, SMMU_MICRO_MMU_CTRL));
+		return SMMU_FAILED;
+	}
+	for (unsigned i = 0; i < sizeof(smmu_impl_defs) / sizeof(smmu_impl_defs[0]); i++) {
+		gpu_wr(smmu, smmu_impl_defs[i][0], smmu_impl_defs[i][1]);
+	}
+	gpu_wr(smmu, SMMU_MICRO_MMU_CTRL, gpu_rd(smmu, SMMU_MICRO_MMU_CTRL) & ~MICRO_MMU_HALT_REQ);
+	printf("SWEET GPU: SMMU resumed: MICRO_MMU_CTRL 0x%08x sCR0 0x%08x\n",
+	    gpu_rd(smmu, SMMU_MICRO_MMU_CTRL), gpu_rd(smmu, SMMU_sCR0));
+	gpu_smmu_smr_test(smmu);
+
+	/* arm_smmu_write_context_bank: TTBCR2/TTBCR before the TTBR. */
+	vm_offset_t cb = smmu + SMMU_CB(GMU_CB);
+	gpu_wr(cb, SMMU_CB_SCTLR, 0);
+	gpu_wr(smmu, SMMU_GR1 + SMMU_CBA2R(GMU_CB), CBA2R_RW64_64BIT);
+	gpu_wr(smmu, SMMU_GR1 + SMMU_CBAR(GMU_CB), CBAR_S1_BYPASS_S2);
+	gpu_wr(cb, SMMU_CB_TTBCR2, TTBCR2_GMU);
+	gpu_wr(cb, SMMU_CB_TCR, TTBCR_GMU);
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(cb + SMMU_CB_TTBR0) = (gmem_pa + GMEM_L1) | ((uint64_t)GMU_ASID << 48);
+	gpu_wr(cb, SMMU_CB_MAIR0, MAIR0_GMU);
+	gpu_wr(cb, SMMU_CB_MAIR1, 0);
+	gpu_wr(cb, SMMU_CB_ACTLR, ACTLR_QCOM);
+	gpu_wr(cb, SMMU_CB_FSR, gpu_rd(cb, SMMU_CB_FSR));      /* write 1 to clear */
+	gpu_wr(cb, SMMU_CB_TLBIALL, 0);
+	if (!smmu_sync(cb, SMMU_CB_TLBSYNC, SMMU_CB_TLBSTATUS)) {
+		return SMMU_FAILED;
+	}
+	gpu_wr(cb, SMMU_CB_SCTLR, SCTLR_GMU);
+
+	printf("SWEET GPU: SMMU CB%u: SCTLR 0x%08x TCR 0x%08x TCR2 0x%08x TTBR0 0x%08x%08x MAIR0 0x%08x\n",
+	    GMU_CB, gpu_rd(cb, SMMU_CB_SCTLR), gpu_rd(cb, SMMU_CB_TCR), gpu_rd(cb, SMMU_CB_TTBCR2),
+	    gpu_rd(cb, SMMU_CB_TTBR0 + 4), gpu_rd(cb, SMMU_CB_TTBR0), gpu_rd(cb, SMMU_CB_MAIR0));
+
+	/*
+	 * One exact entry per stream ID, mask 0, as Linux makes them for the DT
+	 * iommus = <&kgsl_smmu 5> (gmu_kernel) and <&kgsl_smmu 4> (gmu_user).
+	 * 0084: a VALID SMR with id 4 mask 1 read back 0 although the same
+	 * SMRs keep ID/MASK values written without VALID.
+	 */
+	static const uint32_t sids[] = { GMU_SID_KERNEL, GMU_SID_USER };
+	bool routed = true;
+	for (unsigned i = 0; i < sizeof(sids) / sizeof(sids[0]); i++) {
+		uint32_t want = SMR_VALID | sids[i];
+		smmu_write_sme(smmu, GMU_SMR_IDX + i, S2CR_TRANS_CB(GMU_CB), want, "GMU");
+		routed &= gpu_rd(smmu, SMMU_SMR(GMU_SMR_IDX + i)) == want;
+	}
+	if (!routed) {
+		/* Does any VALID SMR stick? An unused ID whose S2CR faults routes nothing. */
+		unsigned probe = GMU_SMR_IDX + 2;
+		uint32_t s2cr0 = gpu_rd(smmu, SMMU_S2CR(probe));
+		smmu_write_sme(smmu, probe, S2CR_FAULT, SMR_VALID | GMU_SID_UNUSED, "probe");
+		gpu_wr(smmu, SMMU_SMR(probe), 0);
+		gpu_wr(smmu, SMMU_S2CR(probe), s2cr0);
+	}
+	gpu_wr(smmu, SMMU_TLBIALLNSNH, 0);
+	if (!smmu_sync(smmu, SMMU_sTLBGSYNC, SMMU_sTLBGSTATUS)) {
+		return SMMU_FAILED;
+	}
+	if (!routed) {
+		printf("SWEET GPU: VALID SMRs for the GMU stream IDs do not stick: GMU streams are not routed\n");
+		return SMMU_UNROUTED;
+	}
+	return SMMU_ROUTED;
+}
+
+/* CP memory stage: resources only; SQE and the ring are not started here. */
+#define CP_CB 1u
+#define CP_ASID 2u
+#define CP_SMR 2u
+#define CP_MEMORY_SIZE 0x20000u
+#define CP_L1 0u
+#define CP_L2 0x1000u
+#define CP_L3 0x2000u
+#define CP_PA_MASK ((1ull << 36) - 0x1000ull)
+#define CP_GPU_VA 0x40000000u
+static vm_offset_t cp_memory;
+static uint64_t cp_memory_pa;
+static const struct {
+	const char *name;
+	uint32_t va, off, size;
+	bool readonly;
+} cp_buffers[] = {
+	{ "ring",    0x40000000u, 0x04000u, 0x8000u, false },
+	{ "sqe",     0x40010000u, 0x0c000u, 0x8000u, true },
+	{ "scratch", 0x40020000u, 0x14000u, 0x4000u, false },
+};
+
+static uint32_t
+cp_fw_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool
+cp_fw_valid(const uint8_t *fw, unsigned size)
+{
+	if (!fw || size < 16 || size > 0x8004 || (size & 3) || cp_fw_u32(fw) != 0) {
+		return false;
+	}
+	uint32_t version = cp_fw_u32(fw + 4), patch = cp_fw_u32(fw + 12);
+	/* Upstream a6xx_ucode_check_version after stripping the file header. */
+	return ((version & 0xf) == 0xa && (patch & 0xf) >= 1) || (version & 0xfff) >= 0x190;
+}
+
+static void
+cp_write64(vm_offset_t base, uint32_t off, uint64_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+cp_build_tables(void)
+{
+	cp_write64(cp_memory, CP_L1 + 8 * (CP_GPU_VA >> 30), (cp_memory_pa + CP_L2) | PTE_TABLE);
+	cp_write64(cp_memory, CP_L2, (cp_memory_pa + CP_L3) | PTE_TABLE);
+	for (unsigned i = 0; i < sizeof(cp_buffers) / sizeof(cp_buffers[0]); ++i) {
+		for (uint32_t off = 0; off < cp_buffers[i].size; off += 0x1000) {
+			uint32_t index = ((cp_buffers[i].va + off) >> 12) & 0x1ff;
+			uint64_t pte = (cp_memory_pa + cp_buffers[i].off + off) | PTE_PAGE_NC;
+			if (cp_buffers[i].readonly) {
+				pte |= 1ull << 7; /* stage-1 AP[2]: read-only, including privileged fetches */
+			}
+			cp_write64(cp_memory, CP_L3 + 8 * index, pte);
+		}
+	}
+}
+
+/* Software walk only: the live GPU SMMU DT explicitly sets qcom,disable-atos. */
+static bool
+cp_walk(uint32_t va, bool write, uint64_t *pa)
+{
+	uint32_t offset = CP_L1;
+	const unsigned shifts[] = { 30, 21, 12 };
+	for (unsigned level = 0; level < 3; ++level) {
+		uint64_t pte = *(volatile uint64_t *)(cp_memory + offset + 8 * ((va >> shifts[level]) & 0x1ff));
+		if ((pte & 3) != PTE_TABLE) {
+			return false;
+		}
+		if (level == 2) {
+			if (!(pte & (1ull << 10)) || (write && (pte & (1ull << 7)))) {
+				return false;
+			}
+			*pa = (pte & CP_PA_MASK) | (va & 0xfff);
+			return true;
+		}
+		uint64_t table = pte & CP_PA_MASK;
+		if (table < cp_memory_pa || table - cp_memory_pa > CP_MEMORY_SIZE - 0x1000) {
+			return false;
+		}
+		offset = (uint32_t)(table - cp_memory_pa);
+	}
+	return false;
+}
+
+static bool
+cp_check_tables(void)
+{
+	unsigned pages = 0;
+	uint64_t pa;
+	for (unsigned i = 0; i < sizeof(cp_buffers) / sizeof(cp_buffers[0]); ++i) {
+		for (uint32_t off = 0; off < cp_buffers[i].size; off += 0x1000) {
+			uint64_t want = cp_memory_pa + cp_buffers[i].off + off;
+			if (!cp_walk(cp_buffers[i].va + off, false, &pa) || pa != want ||
+			    !cp_walk(cp_buffers[i].va + off + 0xfff, false, &pa) || pa != want + 0xfff ||
+			    cp_walk(cp_buffers[i].va + off, true, &pa) == cp_buffers[i].readonly) {
+				return false;
+			}
+			pages++;
+		}
+	}
+	static const uint32_t holes[] = { 0, 0x3ffff000u, 0x40008000u, 0x40018000u, 0x40024000u, 0xffffffffu };
+	for (unsigned i = 0; i < sizeof(holes) / sizeof(holes[0]); ++i) {
+		if (cp_walk(holes[i], false, &pa)) {
+			return false;
+		}
+	}
+	printf("SWEET GPU: CP software walk: %u pages, read-only SQE and %u unmapped guards verified\n",
+	    pages, (unsigned)(sizeof(holes) / sizeof(holes[0])));
+	return true;
+}
+
+static bool
+gpu_cp_memory_setup(void)
+{
+	DTEntry node;
+	const uint8_t *fw = NULL;
+	unsigned size = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "sqe-firmware", (const void **)&fw, &size) != kSuccess || !cp_fw_valid(fw, size)) {
+		printf("SWEET GPU: CP missing or unsupported a630 SQE firmware\n");
+		return false;
+	}
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!smmu || gpu_rd(smmu, SMMU_CB(CP_CB) + SMMU_CB_SCTLR) ||
+	    gpu_rd(smmu, SMMU_CB(CP_CB) + SMMU_CB_TTBR0) ||
+	    gpu_rd(smmu, SMMU_CB(CP_CB) + SMMU_CB_TTBR0 + 4) ||
+	    (gpu_rd(smmu, SMMU_SMR(CP_SMR)) & SMR_VALID)) {
+		printf("SWEET GPU: CP SMMU bank/slot unavailable\n");
+		return false;
+	}
+	unsigned entries = gpu_rd(smmu, SMMU_IDR0) & 0xff;
+	if (entries != 5) {
+		return false;
+	}
+	for (unsigned i = 0; i < entries; ++i) {
+		uint32_t smr = gpu_rd(smmu, SMMU_SMR(i));
+		uint32_t mask = (smr >> 16) & 0x7fff, sid = smr & 0x7fff;
+		if (smr & SMR_VALID) {
+			uint32_t s2cr = gpu_rd(smmu, SMMU_S2CR(i));
+			if (!(sid & ~mask) || ((s2cr & (3u << 16)) == 0 && (s2cr & 0xff) == CP_CB)) {
+				printf("SWEET GPU: CP SID0/CB%u already owned by SMR%u\n", CP_CB, i);
+				return false;
+			}
+		}
+	}
+	if (kmem_alloc_contig(kernel_map, &cp_memory, CP_MEMORY_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: CP memory allocation failed\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)cp_memory);
+	cp_memory_pa = ptoa_64(pn);
+	if (!pn || cp_memory_pa + CP_MEMORY_SIZE > (1ull << 36)) {
+		return false;
+	}
+	for (unsigned i = 0; i < CP_MEMORY_SIZE / PAGE_SIZE; ++i) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(cp_memory + i * PAGE_SIZE)) != pn + i) {
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < CP_MEMORY_SIZE / PAGE_SIZE; ++i) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	flush_dcache64(cp_memory_pa, CP_MEMORY_SIZE, TRUE);
+	memcpy((void *)(cp_memory + cp_buffers[1].off), fw + 4, size - 4);
+	if (memcmp((const void *)(cp_memory + cp_buffers[1].off), fw + 4, size - 4)) {
+		return false;
+	}
+	cp_build_tables();
+	if (!cp_check_tables()) {
+		return false;
+	}
+	printf("SWEET GPU: CP resources at %#llx SQE=%u bytes version=%#x patch=%#x\n",
+	    cp_memory_pa, size - 4, cp_fw_u32(fw + 4), cp_fw_u32(fw + 12));
+	for (unsigned i = 0; i < sizeof(cp_buffers) / sizeof(cp_buffers[0]); ++i) {
+		printf("SWEET GPU: CP %s VA=%#x PA=%#llx size=%#x readonly=%u\n", cp_buffers[i].name,
+		    cp_buffers[i].va, cp_memory_pa + cp_buffers[i].off, cp_buffers[i].size, cp_buffers[i].readonly);
+	}
+	sweet_log_sync();
+	vm_offset_t cb = smmu + SMMU_CB(CP_CB);
+	uint64_t ttbr = (cp_memory_pa + CP_L1) | ((uint64_t)CP_ASID << 48);
+	gpu_wr(smmu, SMMU_GR1 + SMMU_CBA2R(CP_CB), CBA2R_RW64_64BIT);
+	gpu_wr(smmu, SMMU_GR1 + SMMU_CBAR(CP_CB), CBAR_S1_BYPASS_S2);
+	gpu_wr(cb, SMMU_CB_TTBCR2, TTBCR2_GMU);
+	gpu_wr(cb, SMMU_CB_TCR, TTBCR_GMU);
+	cp_write64(cb, SMMU_CB_TTBR0, ttbr);
+	gpu_wr(cb, SMMU_CB_MAIR0, MAIR0_GMU);
+	gpu_wr(cb, SMMU_CB_MAIR1, 0);
+	gpu_wr(cb, SMMU_CB_ACTLR, ACTLR_QCOM);
+	gpu_wr(cb, SMMU_CB_FSR, gpu_rd(cb, SMMU_CB_FSR));
+	gpu_wr(cb, SMMU_CB_TLBIALL, 0);
+	if (!smmu_sync(cb, SMMU_CB_TLBSYNC, SMMU_CB_TLBSTATUS)) {
+		return false;
+	}
+	gpu_wr(cb, SMMU_CB_SCTLR, SCTLR_GMU);
+	if (!(gpu_rd(smmu, SMMU_GR1 + SMMU_CBA2R(CP_CB)) & CBA2R_RW64_64BIT) ||
+	    (gpu_rd(smmu, SMMU_GR1 + SMMU_CBAR(CP_CB)) & 0x3f300u) != CBAR_S1_BYPASS_S2 ||
+	    gpu_rd(cb, SMMU_CB_SCTLR) != SCTLR_GMU || gpu_rd(cb, SMMU_CB_TCR) != TTBCR_GMU ||
+	    gpu_rd(cb, SMMU_CB_TTBCR2) != TTBCR2_GMU || gpu_rd(cb, SMMU_CB_TTBR0) != (uint32_t)ttbr ||
+	    gpu_rd(cb, SMMU_CB_TTBR0 + 4) != (uint32_t)(ttbr >> 32) || gpu_rd(cb, SMMU_CB_MAIR0) != MAIR0_GMU) {
+		printf("SWEET GPU: CP context readback mismatch\n");
+		return false;
+	}
+	smmu_write_sme(smmu, CP_SMR, S2CR_TRANS_CB(CP_CB), SMR_VALID, "CP user SID0");
+	gpu_wr(smmu, SMMU_TLBIALLNSNH, 0);
+	if (!smmu_sync(smmu, SMMU_sTLBGSYNC, SMMU_sTLBGSTATUS) ||
+	    gpu_rd(smmu, SMMU_SMR(CP_SMR)) != SMR_VALID ||
+	    gpu_rd(smmu, SMMU_S2CR(CP_SMR)) != S2CR_TRANS_CB(CP_CB) ||
+	    gpu_rd(smmu, SMMU_sGFSR) || (gpu_rd(cb, SMMU_CB_FSR) & 0xc00001feu)) {
+		printf("SWEET GPU: CP context/stream setup failed\n");
+		return false;
+	}
+	printf("SWEET GPU: CP memory setup complete CB%u ASID%u SID0 SMR%u TTBR=%#llx FSR=%#x; ATOS disabled by DT\n",
+	    CP_CB, CP_ASID, CP_SMR, ttbr, gpu_rd(cb, SMMU_CB_FSR));
+	sweet_log_sync();
+	return true;
+}
+/* End CP memory stage. */
+
+/* Cold register stage. Register indices are DWORDs, not byte offsets.
+ * Phone kernel 1bc20ec6: a6xx_start, a6xx_rb_start, a6xx_microcode_load;
+ * configure while SQE_CNTL is still zero, before the later enable=1.
+ * 0097 showed cold SQE_CNTL=3 raises CP_IRQ bit7 before ROQ setup.
+ * Recovery's halt=3 sequence is not a cold initialization prerequisite.
+ */
+#define A6XX_CP_RB_BASE            0x800u
+#define A6XX_CP_RB_BASE_HI         0x801u
+#define A6XX_CP_RB_CNTL            0x802u
+#define A6XX_CP_RB_RPTR_ADDR_LO    0x804u
+#define A6XX_CP_RB_RPTR_ADDR_HI    0x805u
+#define A6XX_CP_RB_RPTR            0x806u
+#define A6XX_CP_RB_WPTR            0x807u
+#define A6XX_CP_SQE_CNTL           0x808u
+#define A6XX_CP_HW_FAULT           0x821u
+#define A6XX_CP_INTERRUPT_STATUS   0x823u
+#define A6XX_CP_PROTECT_STATUS     0x824u
+#define A6XX_CP_STATUS_1           0x825u
+#define A6XX_CP_ROQ_THRESHOLDS_1   0x8c1u
+#define A6XX_CP_ROQ_THRESHOLDS_2   0x8c2u
+#define A6XX_CP_MEM_POOL_SIZE      0x8c3u
+#define A6XX_CP_AHB_CNTL           0x98du
+#define A6XX_RBBM_INT_0_STATUS     0x201u
+#define A6XX_RBBM_CLOCK_CNTL       0xaeu
+#define A6XX_RBBM_GBIF_HALT        0x16u
+#define A6XX_RBBM_GBIF_HALT_ACK    0x17u
+#define A6XX_GBIF_HALT             0x3c45u
+#define A6XX_GBIF_HALT_ACK         0x3c46u
+#define A6XX_RBBM_SECVID_TRUST_CNTL 0xf400u
+#define A6XX_RBBM_SECVID_TSB_CNTL  0xf803u
+#define A6XX_CP_SQE_STAT_ADDR      0x908u
+#define A6XX_CP_SQE_STAT_DATA      0x909u
+/* 32 KiB = 8192 dwords = 4096 quadwords; 4-dword RPTR update threshold.
+ * Bit27 disables automatic RPTR shadow writes for this first register test.
+ */
+#define CP_RING_CNTL ((1u << 27) | (2u << 8) | 12u)
+
+static bool
+gpu_cp_register_access(void)
+{
+	if (!gmu) {
+		return false;
+	}
+	/* Normal powered register access: phone a6xx_gmu_snapshot checks GX on,
+	 * then selects ALLOW before GX reads. Never change the fence ranges or
+	 * clear dropped-write evidence here. The caller holds powered GX OOB.
+	 */
+	uint32_t before = gpu_rd(gmu, GMU_AO_AHB_FENCE_CTRL);
+	printf("SWEET GPU: CP AHB fence before ctrl=%#x range0=%#x range1=%#x status=%#x\n",
+	    before, gpu_rd(gmu, GMU_AHB_FENCE_RANGE_0), gpu_rd(gmu, GMU_AHB_FENCE_RANGE_1),
+	    gpu_rd(gmu, GMU_AHB_FENCE_STATUS));
+	sweet_log_sync();
+	if (before) {
+		gpu_wr(gmu, GMU_AO_AHB_FENCE_CTRL, 0);
+	}
+	bool allow = gpu_poll(gmu, GMU_AO_AHB_FENCE_CTRL, 0xffffffffu, 0, 1000);
+	printf("SWEET GPU: CP AHB fence ALLOW=%u ctrl=%#x status=%#x\n", allow,
+	    gpu_rd(gmu, GMU_AO_AHB_FENCE_CTRL), gpu_rd(gmu, GMU_AHB_FENCE_STATUS));
+	sweet_log_sync();
+	return allow;
+}
+
+static void
+gpu_cp_diagnostics(vm_offset_t gpu, const char *phase)
+{
+	uint32_t fence = gpu_rd(gmu, GMU_AO_AHB_FENCE_CTRL);
+	printf("SWEET GPU: CP diagnostic %s fence=%#x dropped=%#x\n", phase,
+	    fence, gpu_rd(gmu, GMU_AHB_FENCE_STATUS));
+	/* Do not issue more core reads if the firmware closed its AHB access. */
+	if (!fence) {
+		printf("SWEET GPU: CP diagnostic %s SQE=%#x HW_FAULT=%#x CP_IRQ=%#x PROTECT=%#x CP_STATUS=%#x RBBM_STATUS=%#x RBBM_IRQ=%#x\n",
+		    phase, gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4), gpu_rd(gpu, A6XX_CP_HW_FAULT * 4),
+		    gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4), gpu_rd(gpu, A6XX_CP_PROTECT_STATUS * 4),
+		    gpu_rd(gpu, A6XX_CP_STATUS_1 * 4), gpu_rd(gpu, A6XX_RBBM_STATUS * 4),
+		    gpu_rd(gpu, A6XX_RBBM_INT_0_STATUS * 4));
+	}
+	sweet_log_sync();
+}
+
+static bool
+gpu_cp_clock_enable(vm_offset_t gpu)
+{
+	if (!gmu) {
+		return false;
+	}
+	/* Phone a6xx_hwcg_set enables bit0 before a6xx_start configures CP.
+	 * Do not change HWCG tables here: isolate the missing SP-clock enable.
+	 * Keep GX OOB held and SQE unstarted throughout this register test.
+	 */
+	uint32_t before = gpu_rd(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL);
+	printf("SWEET GPU: CP SP clock before=%#x RBBM_CLOCK_CNTL=%#x ROQ2=%#x\n",
+	    before, gpu_rd(gpu, A6XX_RBBM_CLOCK_CNTL * 4), gpu_rd(gpu, A6XX_CP_ROQ_THRESHOLDS_2 * 4));
+	sweet_log_sync();
+	if (!(before & 1u)) {
+		gpu_wr(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL, before | 1u);
+	}
+	bool enabled = gpu_poll(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL, 1, 1, 1000);
+	uint32_t after = gpu_rd(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL);
+	printf("SWEET GPU: CP SP clock after=%#x expected=%#x enabled=%u\n", after, before | 1u, enabled);
+	sweet_log_sync();
+	return enabled && after == (before | 1u);
+}
+
+static bool
+gpu_cp_context_intact(vm_offset_t smmu)
+{
+	vm_offset_t cb = smmu + SMMU_CB(CP_CB);
+	uint64_t ttbr = cp_memory_pa | ((uint64_t)CP_ASID << 48);
+	uint32_t fsr = gpu_rd(cb, SMMU_CB_FSR), gfsr = gpu_rd(smmu, SMMU_sGFSR);
+	bool ok = gpu_rd(cb, SMMU_CB_SCTLR) == SCTLR_GMU &&
+	    gpu_rd(cb, SMMU_CB_TCR) == TTBCR_GMU && gpu_rd(cb, SMMU_CB_TTBCR2) == TTBCR2_GMU &&
+	    gpu_rd(cb, SMMU_CB_TTBR0) == (uint32_t)ttbr &&
+	    gpu_rd(cb, SMMU_CB_TTBR0 + 4) == (uint32_t)(ttbr >> 32) &&
+	    gpu_rd(cb, SMMU_CB_MAIR0) == MAIR0_GMU && gpu_rd(cb, SMMU_CB_MAIR1) == 0 &&
+	    (gpu_rd(smmu, SMMU_GR1 + SMMU_CBA2R(CP_CB)) & CBA2R_RW64_64BIT) &&
+	    (gpu_rd(smmu, SMMU_GR1 + SMMU_CBAR(CP_CB)) & 0x3f300u) == CBAR_S1_BYPASS_S2 &&
+	    gpu_rd(smmu, SMMU_SMR(CP_SMR)) == SMR_VALID &&
+	    gpu_rd(smmu, SMMU_S2CR(CP_SMR)) == S2CR_TRANS_CB(CP_CB) &&
+	    gpu_rd(smmu, SMMU_SMR(0)) == (SMR_VALID | 5u) &&
+	    gpu_rd(smmu, SMMU_SMR(1)) == (SMR_VALID | 4u) &&
+	    gpu_rd(smmu, SMMU_S2CR(0)) == S2CR_TRANS_CB(0) &&
+	    gpu_rd(smmu, SMMU_S2CR(1)) == S2CR_TRANS_CB(0) &&
+	    !(fsr & 0xc00001feu) && !gfsr;
+	printf("SWEET GPU: CP context %s FSR=%#x GFSR=%#x TTBR=%#x%08x\n",
+	    ok ? "intact" : "changed/faulted", fsr, gfsr,
+	    gpu_rd(cb, SMMU_CB_TTBR0 + 4), gpu_rd(cb, SMMU_CB_TTBR0));
+	return ok;
+}
+
+static bool
+gpu_cp_configure_cold(void)
+{
+	if (!cp_memory || !cp_memory_pa) {
+		printf("SWEET GPU: CP register setup missing owned memory\n");
+		return false;
+	}
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!smmu || !gpu || !gpu_cp_context_intact(smmu) || !cp_check_tables()) {
+		printf("SWEET GPU: CP register setup prerequisite failed\n");
+		return false;
+	}
+	if (!gpu_cp_register_access()) {
+		printf("SWEET GPU: CP AHB access not ready; setup stopped\n");
+		return false;
+	}
+	if (!gpu_cp_clock_enable(gpu)) {
+		printf("SWEET GPU: CP SP clock enable failed; setup stopped\n");
+		return false;
+	}
+	gpu_cp_diagnostics(gpu, "cold entry");
+	printf("SWEET GPU: CP cold entry SQE_CNTL=%#x RB=%#x/%#x SQE=%#x/%#x RPTR=%#x WPTR=%#x\n",
+	    gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4), gpu_rd(gpu, A6XX_CP_RB_BASE * 4),
+	    gpu_rd(gpu, A6XX_CP_RB_BASE_HI * 4), gpu_rd(gpu, A6XX_CP_SQE_INSTR_BASE_LO * 4),
+	    gpu_rd(gpu, (A6XX_CP_SQE_INSTR_BASE_LO + 1) * 4),
+	    gpu_rd(gpu, A6XX_CP_RB_RPTR * 4), gpu_rd(gpu, A6XX_CP_RB_WPTR * 4));
+	sweet_log_sync();
+	/* Do not write SQE_CNTL at all. Refuse non-cold state or existing errors;
+	 * never clear faults to make this initialization test appear successful.
+	 */
+	if (gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4) || gpu_rd(gpu, A6XX_CP_HW_FAULT * 4) ||
+	    gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4) ||
+	    gpu_rd(gpu, A6XX_CP_RB_BASE * 4) || gpu_rd(gpu, A6XX_CP_RB_BASE_HI * 4) ||
+	    gpu_rd(gpu, A6XX_CP_SQE_INSTR_BASE_LO * 4) ||
+	    gpu_rd(gpu, (A6XX_CP_SQE_INSTR_BASE_LO + 1) * 4) ||
+	    gpu_rd(gpu, A6XX_CP_RB_RPTR * 4) || gpu_rd(gpu, A6XX_CP_RB_WPTR * 4)) {
+		printf("SWEET GPU: CP has inherited state or faults; cold setup stopped\n");
+		return false;
+	}
+	/* a618 thresholds and pool size from the phone driver; no UCHE/rendering
+	 * setup or protected/security register access in this stage.
+	 */
+	/*
+	 * Write probe (diagnostic, boot 2026-11-02): the CP register file ignored the
+	 * first write. Write the non-CP registers the working A630 bring-up (0103
+	 * gpu_cp_hw_init) writes first, in its order, read each back and carry on, to
+	 * see whether the whole GPU register space ignores writes or only the CP block.
+	 * Every value is a Linux a6xx_hw_init value; none starts the CP or touches the
+	 * secure (SECVID) registers.
+	 */
+	{
+		const struct { const char *name; uint32_t reg, value; } probe[] = {
+			{ "CP_ADDR_MODE_CNTL",       0x842,  1 },
+			{ "VSC_ADDR_MODE_CNTL",      0xc01,  1 },
+			{ "GRAS_ADDR_MODE_CNTL",     0x8601, 1 },
+			{ "RB_ADDR_MODE_CNTL",       0x8e05, 1 },
+			{ "UCHE_ADDR_MODE_CNTL",     0xe00,  1 },
+			{ "RBBM_CLIENT_QOS_CNTL",    0x3da,  3 },
+			{ "RBBM_PERFCTR_BUSY_MASK",  0x50b,  0xffffffffu },
+			{ "UCHE_WRITE_THRU_BASE",    0xe07,  0xfffff000u },
+			{ "UCHE_GMEM_RANGE_MIN",     0xe0b,  0x100000 },
+			{ "UCHE_FILTER_CNTL",        0xe18,  0x804 },
+			{ "UCHE_CACHE_WAYS",         0xe17,  0x4 },
+			{ "PC_DBG_ECO_CNTL",         0x9e00, 0x00180000 },
+			{ "RBBM_INTF_HANG_INT_CNTL", 0x1f,   (1u << 30) | 0x1fffff },
+		};
+		unsigned stuck = 0;
+		for (unsigned i = 0; i < sizeof(probe) / sizeof(probe[0]); ++i) {
+			uint32_t was = gpu_rd(gpu, probe[i].reg * 4);
+			gpu_wr(gpu, probe[i].reg * 4, probe[i].value);
+			uint32_t got = gpu_rd(gpu, probe[i].reg * 4);
+			printf("SWEET GPU: probe %-24s reg=%#x was=%#x wrote=%#x read=%#x %s\n", probe[i].name,
+			    probe[i].reg, was, probe[i].value, got, got == probe[i].value ? "STICKS" : "IGNORED");
+			sweet_log_sync();
+			stuck += got == probe[i].value;
+		}
+		printf("SWEET GPU: probe: %u of %zu writes stuck; AHB fence status=%#x\n", stuck,
+		    sizeof(probe) / sizeof(probe[0]), gpu_rd(gmu, GMU_AHB_FENCE_STATUS));
+		sweet_log_sync();
+	}
+	/* The A630 bring-up (0103 gpu_cp_hw_init) writes the UCHE ranges as 64-bit values; the probe above wrote
+	 * only the low words. a618 GMEM is 512 KiB. Read back and log; carry on either way. */
+	{
+		const struct { const char *name; uint32_t reg, lo, hi; } u64[] = {
+			{ "UCHE_WRITE_RANGE_MAX", 0xe05, 0xffffffc0u, 0x0001ffffu },
+			{ "UCHE_TRAP_BASE",       0xe09, 0xfffff000u, 0x0001ffffu },
+			{ "UCHE_WRITE_THRU_BASE", 0xe07, 0xfffff000u, 0x0001ffffu },
+			{ "UCHE_GMEM_RANGE_MIN",  0xe0b, 0x00100000u, 0 },
+			{ "UCHE_GMEM_RANGE_MAX",  0xe0d, 0x00100000u + 0x80000u - 1, 0 },
+		};
+		for (unsigned i = 0; i < sizeof(u64) / sizeof(u64[0]); ++i) {
+			gpu_wr(gpu, u64[i].reg * 4, u64[i].lo);
+			gpu_wr(gpu, (u64[i].reg + 1) * 4, u64[i].hi);
+			uint32_t lo = gpu_rd(gpu, u64[i].reg * 4), hi = gpu_rd(gpu, (u64[i].reg + 1) * 4);
+			printf("SWEET GPU: uche64 %-22s reg=%#x wrote=%#x:%08x read=%#x:%08x %s\n", u64[i].name, u64[i].reg,
+			    u64[i].hi, u64[i].lo, hi, lo, (lo == u64[i].lo && hi == u64[i].hi) ? "STICKS" : "IGNORED");
+		}
+		gpu_wr(gpu, 0xe19 * 4, (1u << 7) | 1);   /* UCHE_CLIENT_PF */
+		printf("SWEET GPU: uche64 UCHE_CLIENT_PF read=%#x\n", gpu_rd(gpu, 0xe19 * 4));
+		sweet_log_sync();
+	}
+	unsigned mismatch_fatal = 0;
+	const struct { uint32_t reg, value; bool must_stick; } setup[] = {
+		{ A6XX_CP_ROQ_THRESHOLDS_2, 0x010000c0, false },
+		{ A6XX_CP_ROQ_THRESHOLDS_1, 0x8040362c, false },
+		{ A6XX_CP_MEM_POOL_SIZE, 128, false },
+		{ A6XX_CP_AHB_CNTL, 1, false },
+		{ A6XX_CP_RB_RPTR_ADDR_LO, cp_buffers[2].va, true },
+		{ A6XX_CP_RB_RPTR_ADDR_HI, 0, true },
+		{ A6XX_CP_RB_CNTL, CP_RING_CNTL, true },
+		{ A6XX_CP_RB_BASE, cp_buffers[0].va, true },
+		{ A6XX_CP_RB_BASE_HI, 0, true },
+		{ A6XX_CP_SQE_INSTR_BASE_LO, cp_buffers[1].va, true },
+		{ A6XX_CP_SQE_INSTR_BASE_LO + 1, 0, true },
+	};
+	for (unsigned i = 0; i < sizeof(setup) / sizeof(setup[0]); ++i) {
+		gpu_wr(gpu, setup[i].reg * 4, setup[i].value);
+		uint32_t got = gpu_rd(gpu, setup[i].reg * 4);
+		printf("SWEET GPU: CP reg[%#x] wrote=%#x read=%#x\n", setup[i].reg, setup[i].value, got);
+		if (got != setup[i].value) {
+			/* Boot 2026-11-02: the probe showed the GPU block takes writes (UCHE, ADDR_MODE
+			 * stick); CP_ROQ_THRESHOLDS_2 (0x8c2) reads 0. Log every mismatch and go on:
+			 * only the ring and SQE base registers must read back. */
+			printf("SWEET GPU: CP reg[%#x] MISMATCH (wrote %#x, read %#x)%s\n", setup[i].reg, setup[i].value, got,
+			    setup[i].must_stick ? " FATAL" : " (not required)");
+			if (setup[i].must_stick) {
+				mismatch_fatal++;
+			}
+		}
+	}
+	if (mismatch_fatal) {
+		printf("SWEET GPU: CP cold configuration readback mismatch (%u required registers)\n", mismatch_fatal);
+		gpu_cp_diagnostics(gpu, "register mismatch");
+		return false;
+	}
+	uint32_t fault = gpu_rd(gpu, A6XX_CP_HW_FAULT * 4);
+	uint32_t irq = gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4);
+	printf("SWEET GPU: CP cold status SQE_CNTL=%#x RPTR=%#x WPTR=%#x HW_FAULT=%#x CP_IRQ=%#x RBBM_IRQ=%#x\n",
+	    gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4), gpu_rd(gpu, A6XX_CP_RB_RPTR * 4),
+	    gpu_rd(gpu, A6XX_CP_RB_WPTR * 4), fault, irq, gpu_rd(gpu, A6XX_RBBM_INT_0_STATUS * 4));
+	if (fault || irq || gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4) ||
+	    gpu_rd(gpu, A6XX_CP_RB_RPTR * 4) || gpu_rd(gpu, A6XX_CP_RB_WPTR * 4) ||
+	    !gpu_cp_context_intact(smmu)) {
+		return false;
+	}
+	printf("SWEET GPU: CP cold configuration verified; SQE control remains zero; no commands submitted\n");
+	sweet_log_sync();
+	return true;
+}
+/* End cold CP register stage. */
+
+/* Read-only post-PAS comparison. No reprogramming after the signed test. */
+static bool
+gpu_cp_post_pas_check(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!gpu || !smmu) {
+		return false;
+	}
+	uint32_t control = gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4);
+	uint32_t roq = gpu_rd(gpu, A6XX_CP_ROQ_THRESHOLDS_2 * 4);
+	uint32_t ring = gpu_rd(gpu, A6XX_CP_RB_BASE * 4);
+	uint32_t sqe = gpu_rd(gpu, A6XX_CP_SQE_INSTR_BASE_LO * 4);
+	uint32_t fault = gpu_rd(gpu, A6XX_CP_HW_FAULT * 4);
+	uint32_t irq = gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4);
+	printf("SWEET GPU: CP post-PAS snapshot SQE_CNTL=%#x ROQ2=%#x ring=%#x SQE=%#x fault=%#x irq=%#x\n",
+	    control, roq, ring, sqe, fault, irq);
+	bool ok = control == 0 && roq == 0x010000c0 && ring == cp_buffers[0].va && sqe == cp_buffers[1].va &&
+	    !gpu_rd(gpu, A6XX_CP_RB_BASE_HI * 4) &&
+	    !gpu_rd(gpu, (A6XX_CP_SQE_INSTR_BASE_LO + 1) * 4) &&
+	    !gpu_rd(gpu, A6XX_CP_RB_RPTR * 4) && !gpu_rd(gpu, A6XX_CP_RB_WPTR * 4) &&
+	    !fault && !irq && gpu_cp_context_intact(smmu);
+	sweet_log_sync();
+	return ok;
+}
+/* End post-PAS CP comparison. */
+/*
+ * sweetgpu=10: start the CP and run a first command stream (Linux a6xx_hw_init order, as
+ * the working A630 bring-up 0103 gpu_cp_start/gpu_cp_nop_test): SQE_CNTL=1, CP_ME_INIT,
+ * then (zap authenticated) CP_SET_SECURE_MODE 0, a NOP, a CP_MEM_WRITE and a
+ * CACHE_FLUSH_TS timestamp, both read back from the scratch buffer. SECVID registers are
+ * never touched. Boot 2026-11-02 showed the register block takes writes; this is the
+ * first time this tree asks the CP to execute.
+ */
+#define CP_NOP                  16
+#define CP_ME_INIT              72
+#define CP_MEM_WRITE            61
+#define CP_EVENT_WRITE          70
+#define CP_SET_SECURE_MODE      102
+#define CACHE_FLUSH_TS          4
+#define CP_EVENT_WRITE_IRQ      0x80000000u
+#define CP_RING_OFF             0x04000u
+#define CP_RING_BYTES           0x8000u
+#define CP_SCRATCH_OFF          0x14000u
+#define CP_SCRATCH_VA           0x40020000u
+#define CP_SCRATCH_MEMWR        0x100u
+#define CP_SCRATCH_TS           0x110u
+static unsigned cp_ring_wptr;   /* dwords */
+
+static uint32_t
+cp_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+cp_pkt7(unsigned opcode, unsigned cnt)
+{
+	return 0x70000000u | cnt | (cp_parity(cnt) << 15) | ((opcode & 0x7fu) << 16) | (cp_parity(opcode) << 23);
+}
+
+static void
+cp_ring_emit(uint32_t v)
+{
+	*(volatile uint32_t *)(cp_memory + CP_RING_OFF + 4u * cp_ring_wptr) = v;
+	cp_ring_wptr = (cp_ring_wptr + 1) % (CP_RING_BYTES / 4);
+}
+
+static void
+cp_ring_flush(vm_offset_t gpu)
+{
+	flush_dcache64((addr64_t)(cp_memory_pa + CP_RING_OFF), CP_RING_BYTES, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gpu_wr(gpu, A6XX_CP_RB_WPTR * 4, cp_ring_wptr);
+}
+
+static void
+cp_status_line(vm_offset_t gpu, const char *when)
+{
+	printf("SWEET GPU: CP %s: SQE_CNTL %#x RPTR %u WPTR %u HW_FAULT %#x CP_IRQ %#x PROTECT %#x CP_STATUS_1 %#x RBBM_STATUS %#x RBBM_IRQ %#x\n",
+	    when, gpu_rd(gpu, A6XX_CP_SQE_CNTL * 4), gpu_rd(gpu, A6XX_CP_RB_RPTR * 4), gpu_rd(gpu, A6XX_CP_RB_WPTR * 4),
+	    gpu_rd(gpu, A6XX_CP_HW_FAULT * 4), gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4), gpu_rd(gpu, A6XX_CP_PROTECT_STATUS * 4),
+	    gpu_rd(gpu, A6XX_CP_STATUS_1 * 4), gpu_rd(gpu, A6XX_RBBM_STATUS * 4), gpu_rd(gpu, A6XX_RBBM_INT_0_STATUS * 4));
+	sweet_log_sync();
+}
+
+static void gpu_smmu_cb_faults(void);
+
+/*
+ * Run A (2026-11-02): read-only diagnostics, no behaviour change. Every register that could
+ * plausibly stop the SoC is read after a log sync, so the last printed line names it.
+ */
+static void
+cp_diag(vm_offset_t gpu, const char *when)
+{
+	printf("SWEET GPU: DIAG %s: GBIF_HALT %#x ACK %#x RBBM_GBIF_HALT %#x ACK %#x SECVID_TSB_CNTL %#x\n", when,
+	    gpu_rd(gpu, A6XX_GBIF_HALT * 4), gpu_rd(gpu, A6XX_GBIF_HALT_ACK * 4),
+	    gpu_rd(gpu, A6XX_RBBM_GBIF_HALT * 4), gpu_rd(gpu, A6XX_RBBM_GBIF_HALT_ACK * 4),
+	    gpu_rd(gpu, A6XX_RBBM_SECVID_TSB_CNTL * 4));
+	sweet_log_sync();
+	gpu_wr(gpu, A6XX_CP_SQE_STAT_ADDR * 4, 1);
+	printf("SWEET GPU: DIAG %s: CP_SQE_STAT_DATA %#x CP_HW_FAULT %#x CP_PROTECT_STATUS %#x\n", when,
+	    gpu_rd(gpu, A6XX_CP_SQE_STAT_DATA * 4), gpu_rd(gpu, A6XX_CP_HW_FAULT * 4), gpu_rd(gpu, A6XX_CP_PROTECT_STATUS * 4));
+	sweet_log_sync();
+	printf("SWEET GPU: DIAG %s: reading RBBM_SECVID_TRUST_CNTL\n", when);
+	sweet_log_sync();
+	printf("SWEET GPU: DIAG %s: RBBM_SECVID_TRUST_CNTL %#x\n", when, gpu_rd(gpu, A6XX_RBBM_SECVID_TRUST_CNTL * 4));
+	sweet_log_sync();
+}
+static bool
+cp_ring_wait_idle(vm_offset_t gpu, const char *what)
+{
+	for (unsigned i = 0; i < 100000; i++) {
+		if (gpu_rd(gpu, A6XX_CP_RB_RPTR * 4) == cp_ring_wptr) {
+			printf("SWEET GPU: CP %s: ring idle (RPTR=WPTR=%u) RBBM_STATUS %#x\n", what, cp_ring_wptr,
+			    gpu_rd(gpu, A6XX_RBBM_STATUS * 4));
+			sweet_log_sync();
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET GPU: CP %s: ring did NOT drain\n", what);
+	cp_status_line(gpu, "after timeout");
+	return false;
+}
+
+/* SQE_CNTL 0 -> 1 (the only value Linux writes), then a6xx_cp_init's CP_ME_INIT. */
+static bool
+gpu_cp_start(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	cp_ring_wptr = 0;
+	gpu_wr(gpu, A6XX_CP_SQE_CNTL * 4, 1);
+	cp_status_line(gpu, "SQE enabled");
+	cp_ring_emit(cp_pkt7(CP_ME_INIT, 8));
+	cp_ring_emit(0x0000002f);
+	cp_ring_emit(0x00000003);
+	cp_ring_emit(0x20000000);
+	for (unsigned i = 0; i < 5; i++) {
+		cp_ring_emit(0);
+	}
+	cp_ring_flush(gpu);
+	return cp_ring_wait_idle(gpu, "CP_ME_INIT");
+}
+
+/* Runs between the zap's AUTH_AND_RESET and its SHUTDOWN (sweet_scm.c hook). */
+static bool
+gpu_cp_secure_nop(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	volatile uint32_t *memwr = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF + CP_SCRATCH_MEMWR);
+	volatile uint32_t *ts = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF + CP_SCRATCH_TS);
+	const uint32_t memval = 0x5ee70001u, seq = 0x600d0001u;
+	uint32_t nots = 0, nomw = 0;
+	PE_parse_boot_argn("sweetgpunots", &nots, sizeof(nots));   /* Run B: skip CACHE_FLUSH_TS */
+	PE_parse_boot_argn("sweetgpunomw", &nomw, sizeof(nomw));   /* Run C: skip CP_MEM_WRITE */
+	cp_diag(gpu, "before CP_SET_SECURE_MODE");
+	cp_ring_emit(cp_pkt7(CP_SET_SECURE_MODE, 1));
+	cp_ring_emit(0);
+	cp_ring_flush(gpu);
+	if (!cp_ring_wait_idle(gpu, "CP_SET_SECURE_MODE 0")) {
+		return false;
+	}
+	cp_diag(gpu, "after CP_SET_SECURE_MODE");
+	*memwr = 0;
+	*ts = 0;
+	flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x200, TRUE);
+	/* One packet at a time: after each, the ring state and CP_INTERRUPT_STATUS say which one the SQE rejects. */
+	cp_status_line(gpu, "before the single packets");
+	cp_ring_emit(cp_pkt7(CP_NOP, 1));
+	cp_ring_emit(0);
+	cp_ring_flush(gpu);
+	bool idle = cp_ring_wait_idle(gpu, "CP_NOP");
+	cp_status_line(gpu, "after CP_NOP");
+	if (nomw) {
+		printf("SWEET GPU: CP CP_MEM_WRITE skipped (sweetgpunomw=1)\n");
+		sweet_log_sync();
+	} else {
+	cp_ring_emit(cp_pkt7(CP_MEM_WRITE, 3));
+	cp_ring_emit((uint32_t)(CP_SCRATCH_VA + CP_SCRATCH_MEMWR));
+	cp_ring_emit(0);
+	cp_ring_emit(memval);
+	cp_ring_flush(gpu);
+	idle = cp_ring_wait_idle(gpu, "CP_MEM_WRITE") && idle;
+	}
+	cp_status_line(gpu, "after CP_MEM_WRITE");
+	cp_diag(gpu, "after CP_MEM_WRITE");
+	if (nots) {
+		printf("SWEET GPU: CP CACHE_FLUSH_TS skipped (sweetgpunots=1)\n");
+		sweet_log_sync();
+	} else {
+	cp_ring_emit(cp_pkt7(CP_EVENT_WRITE, 4));
+	cp_ring_emit(CACHE_FLUSH_TS | CP_EVENT_WRITE_IRQ);
+	cp_ring_emit((uint32_t)(CP_SCRATCH_VA + CP_SCRATCH_TS));
+	cp_ring_emit(0);
+	cp_ring_emit(seq);
+	cp_ring_flush(gpu);
+	idle = cp_ring_wait_idle(gpu, "CACHE_FLUSH_TS") && idle;
+	}
+	for (unsigned i = 0; i < 50000 && ((!nomw && *memwr != memval) || (!nots && *ts != seq)); i++) {
+		flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x200, TRUE);
+		delay(1);
+	}
+	printf("SWEET GPU: CP NOP test: CP_MEM_WRITE read back %#010x (want %#010x), CACHE_FLUSH_TS timestamp %#010x (want %#010x), RBBM_INT_0_STATUS %#x\n",
+	    *memwr, memval, *ts, seq, gpu_rd(gpu, A6XX_RBBM_INT_0_STATUS * 4));
+	cp_status_line(gpu, "after NOP submission");
+	cp_diag(gpu, "after the test");
+	gpu_smmu_cb_faults();
+	bool ok = idle && (nomw || *memwr == memval) && (nots || *ts == seq);
+	printf("SWEET GPU: CP NOP test %s\n", ok ? "PASSED: the CP fetched, executed and wrote back through the GPU SMMU" : "FAILED");
+	sweet_log_sync();
+	return ok;
+}
+
+
+static void
+gpu_smmu_cb_faults(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu == 0) {
+		return;
+	}
+	vm_offset_t cb = smmu + SMMU_CB(GMU_CB);
+	printf("SWEET GPU: SMMU CB%u FSR 0x%08x FSYNR0 0x%08x FAR 0x%08x%08x\n", GMU_CB,
+	    gpu_rd(cb, SMMU_CB_FSR), gpu_rd(cb, SMMU_CB_FSYNR0), gpu_rd(cb, SMMU_CB_FAR + 4), gpu_rd(cb, SMMU_CB_FAR));
+}
+
+/* hfi_init with the a630 / a615-family legacy queue IDs. */
+static void
+gpu_hfi_table(void)
+{
+	static const struct {
+		uint32_t idx, pri, status;
+	} q[HFI_QUEUES] = {
+		{ 0, 10, 1 },   /* CMD */
+		{ 4, 10, 1 },   /* MSG, HFI_MSG_IDX_LEGACY */
+		{ 5, 40, 1 },   /* DBG, HFI_DBG_IDX_LEGACY */
+		{ 1, 20, 0 },   /* DSP 0, HFI_DSP_IDX_0_LEGACY, disabled */
+	};
+	uint32_t t = GMEM_HFI;
+
+	gm_wr(t + 0, 0);                                        /* version */
+	gm_wr(t + 4, HFI_QTBL_HDR_DW + HFI_QUEUES * HFI_QHDR_DW);
+	gm_wr(t + 8, HFI_QTBL_HDR_DW);                          /* qhdr0_offset */
+	gm_wr(t + 12, HFI_QHDR_DW);
+	gm_wr(t + 16, HFI_QUEUES);
+	gm_wr(t + 20, HFI_QUEUES);
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		uint32_t h = t + 4 * (HFI_QTBL_HDR_DW + i * HFI_QHDR_DW);
+		for (unsigned w = 0; w < HFI_QHDR_DW; w++) {
+			gm_wr(h + 4 * w, 0);
+		}
+		gm_wr(h + 4 * QH_STATUS, q[i].status);
+		gm_wr(h + 4 * QH_START_ADDR, GMU_VA_HFI + HFI_QUEUE_OFF(i));
+		gm_wr(h + 4 * QH_TYPE, q[i].idx | (q[i].pri << 8));
+		gm_wr(h + 4 * QH_QUEUE_SIZE, HFI_QUEUE_DW);
+		gm_wr(h + 4 * QH_RX_WM, 1);
+		gm_wr(h + 4 * QH_TX_WM, 1);
+		gm_wr(h + 4 * QH_RX_REQ, 1);
+	}
+}
+
+static uint32_t
+hfi_qh(unsigned q, unsigned word)
+{
+	return GMEM_HFI + 4 * (HFI_QTBL_HDR_DW + q * HFI_QHDR_DW + word);
+}
+
+/* hfi_queue_write (v1: no 4-dword padding); n dwords, msg[0] the header. */
+static bool
+hfi_write(unsigned q, uint32_t *msg, unsigned n)
+{
+	uint32_t base = GMEM_HFI + HFI_QUEUE_OFF(q);
+	uint32_t rd = gm_rd(hfi_qh(q, QH_READ_INDEX)), wr = gm_rd(hfi_qh(q, QH_WRITE_INDEX));
+	uint32_t space = wr >= rd ? HFI_QUEUE_DW - (wr - rd) : rd - wr;
+
+	if (wr >= HFI_QUEUE_DW || space < n) {
+		printf("SWEET GPU: HFI queue %u full or corrupt (rd %u wr %u)\n", q, rd, wr);
+		return false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		gm_wr(base + 4 * wr, msg[i]);
+		wr = (wr + 1) % HFI_QUEUE_DW;
+	}
+	gm_wr(hfi_qh(q, QH_WRITE_INDEX), wr);
+	gpu_wr(gmu, GMU_HOST2GMU_INTR_SET, 1);                 /* after the packet and index */
+	return true;
+}
+
+/* hfi_queue_read: one message into out (max dwords); returns its size, 0 if none. */
+static unsigned
+hfi_read(unsigned q, uint32_t *out, unsigned max)
+{
+	uint32_t base = GMEM_HFI + HFI_QUEUE_OFF(q);
+	uint32_t rd = gm_rd(hfi_qh(q, QH_READ_INDEX)), wr = gm_rd(hfi_qh(q, QH_WRITE_INDEX));
+
+	if (rd == wr) {
+		return 0;
+	}
+	if (rd >= HFI_QUEUE_DW || wr >= HFI_QUEUE_DW) {
+		printf("SWEET GPU: HFI queue %u indices out of range (rd %u wr %u)\n", q, rd, wr);
+		return 0;
+	}
+	uint32_t hdr = gm_rd(base + 4 * rd), n = MSG_DW(hdr);
+	if (n == 0 || n > max) {
+		printf("SWEET GPU: HFI queue %u: bad message 0x%08x at %u; queue dropped\n", q, hdr, rd);
+		gm_wr(hfi_qh(q, QH_READ_INDEX), wr);
+		return 0;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		out[i] = gm_rd(base + 4 * rd);
+		rd = (rd + 1) % HFI_QUEUE_DW;
+	}
+	gm_wr(hfi_qh(q, QH_READ_INDEX), rd);
+	return n;
+}
+
+static void
+hfi_drain_debug(void)
+{
+	uint32_t m[19];
+	unsigned n;
+
+	while ((n = hfi_read(HFI_DBG_ID, m, 19)) != 0) {
+		printf("SWEET GPU: HFI debug 0x%08x (id %u): %08x %08x %08x %08x\n", m[0], MSG_ID(m[0]),
+		    n > 1 ? m[1] : 0, n > 2 ? m[2] : 0, n > 3 ? m[3] : 0, n > 4 ? m[4] : 0);
+	}
+}
+
+/*
+ * hfi_send_cmd + hfi_v1_receiver: send on the command queue, wait for the
+ * message-queue bit in GMU2HOST_INTR_INFO, return the V1 ACK carrying our
+ * sequence number (ack[1] = our header, ack[2] = error, ack[3..] = result).
+ */
+static bool
+hfi_cmd(const char *name, uint32_t *msg, unsigned n, uint32_t *ack, unsigned ack_max)
+{
+	msg[0] = (msg[0] & 0xfffff) | (++hfi_seq << 20);
+	printf("SWEET GPU: HFI %s: sending 0x%08x (%u dwords)\n", name, msg[0], n);
+	sweet_log_sync();
+	if (!hfi_write(HFI_CMD_ID, msg, n)) {
+		return false;
+	}
+	if (!gpu_poll(gmu, GMU_GMU2HOST_INTR_INFO, HFI_IRQ_MSGQ, HFI_IRQ_MSGQ, HFI_RSP_TIMEOUT_US)) {
+		printf("SWEET GPU: HFI %s: no reply (INTR_INFO 0x%08x)\n", name, gpu_rd(gmu, GMU_GMU2HOST_INTR_INFO));
+		hfi_drain_debug();
+		return false;
+	}
+	gpu_wr(gmu, GMU_GMU2HOST_INTR_CLR, HFI_IRQ_MSGQ);
+	unsigned got;
+	while ((got = hfi_read(HFI_MSG_ID, ack, ack_max)) != 0) {
+		if (MSG_TYPE(ack[0]) == HFI_V1_MSG_ACK && got >= 3 && MSG_SEQ(ack[1]) == MSG_SEQ(msg[0])) {
+			printf("SWEET GPU: HFI %s: ACK 0x%08x for 0x%08x, error %u, data 0x%08x\n",
+			    name, ack[0], ack[1], ack[2], got > 3 ? ack[3] : 0);
+			hfi_drain_debug();
+			return ack[2] == 0;
+		}
+		printf("SWEET GPU: HFI %s: other message 0x%08x (id %u) %08x %08x\n",
+		    name, ack[0], MSG_ID(ack[0]), got > 1 ? ack[1] : 0, got > 2 ? ack[2] : 0);
+	}
+	printf("SWEET GPU: HFI %s: interrupt but no ACK\n", name);
+	hfi_drain_debug();
+	return false;
+}
+
+/* Queue indices and the start of the GMU's log and crash-dump buffers. */
+static void
+gpu_hfi_dump(void)
+{
+	for (unsigned q = 0; q < HFI_QUEUES; q++) {
+		printf("SWEET GPU: HFI queue %u: status %u rd %u wr %u drop %u rx_req %u tx_req %u\n", q,
+		    gm_rd(hfi_qh(q, QH_STATUS)), gm_rd(hfi_qh(q, QH_READ_INDEX)), gm_rd(hfi_qh(q, QH_WRITE_INDEX)),
+		    gm_rd(hfi_qh(q, 5)), gm_rd(hfi_qh(q, QH_RX_REQ)), gm_rd(hfi_qh(q, 9)));
+	}
+	for (unsigned i = 0; i < 16; i += 8) {
+		printf("SWEET GPU: GMU log +%02x: %08x %08x %08x %08x %08x %08x %08x %08x\n", 4 * i,
+		    gm_rd(GMEM_LOG + 4 * i), gm_rd(GMEM_LOG + 4 * (i + 1)), gm_rd(GMEM_LOG + 4 * (i + 2)),
+		    gm_rd(GMEM_LOG + 4 * (i + 3)), gm_rd(GMEM_LOG + 4 * (i + 4)), gm_rd(GMEM_LOG + 4 * (i + 5)),
+		    gm_rd(GMEM_LOG + 4 * (i + 6)), gm_rd(GMEM_LOG + 4 * (i + 7)));
+	}
+	printf("SWEET GPU: GMU dump +00: %08x %08x %08x %08x, dummy +00: %08x\n",
+	    gm_rd(GMEM_DUMP), gm_rd(GMEM_DUMP + 4), gm_rd(GMEM_DUMP + 8), gm_rd(GMEM_DUMP + 12), gm_rd(GMEM_DUMMY));
+}
+
+static unsigned
+gx_vlvl(unsigned mhz)
+{
+	if (mhz == 0) {
+		return 0;                       /* KGSL hardcodes VLVL 0 for the 0 Hz level */
+	}
+	for (unsigned i = 0; i < sizeof(gx_corners) / sizeof(gx_corners[0]); i++) {
+		if (mhz <= gx_corners[i].mhz) {
+			return gx_corners[i].vlvl;
+		}
+	}
+	return 0xffff;
+}
+
+/*
+ * setup_volt_dependency_tbl: for each level, the first primary-rail ARC
+ * index whose VLVL covers it, and the first secondary (MX) index at or
+ * above that VLVL (else the last one).
+ */
+static bool
+arc_vote_tbl(const char *what, const uint16_t *pri, unsigned npri, const uint16_t *sec, unsigned nsec,
+    const unsigned *vlvl, unsigned n, uint32_t *votes)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned k, j;
+		for (k = 0; k < npri && pri[k] < vlvl[i]; k++) {
+		}
+		if (k == npri) {
+			printf("SWEET GPU: %s level %u: VLVL %u above the %u ARC levels\n", what, i, vlvl[i], npri);
+			return false;
+		}
+		for (j = 0; j < nsec; j++) {
+			if (sec[j] >= pri[k] || j + 1 == nsec) {
+				break;
+			}
+		}
+		votes[i] = ARC_VOTE(k, j == nsec ? 0 : j, pri[k]);
+	}
+	return true;
+}
+
+/* The ARC tables from cmd-db and the GX/CX DCVS votes for the fused speed bin. */
+static bool
+gpu_dcvs_votes(void)
+{
+	static const char *const arcs[] = { "gfx.lvl", "mx.lvl", "cx.lvl" };
+	uint16_t lvl[3][MAX_GX_LEVELS];
+	unsigned num[3], gx_vl[MAX_GX_LEVELS], cx_vl[MAX_CX_LEVELS] = { 0, 48 };
+	uint32_t addr[3];
+	vm_offset_t qfprom = ml_io_map(QFPROM_PA, QFPROM_SIZE);
+
+	if (qfprom == 0) {
+		return false;
+	}
+	uint32_t fuse = gpu_rd(qfprom, QFPROM_GPU_SPEED_BIN), bin = (fuse & 0x1fe00000u) >> 21;
+	unsigned b;
+	for (b = 0; b < sizeof(gpu_bins) / sizeof(gpu_bins[0]) && gpu_bins[b].bin != bin; b++) {
+	}
+	if (b == sizeof(gpu_bins) / sizeof(gpu_bins[0])) {
+		printf("SWEET GPU: speed bin 0x%x (fuse 0x%08x) not in the DT; no DCVS table\n", bin, fuse);
+		return false;
+	}
+	unsigned nlev = gpu_bins[b].n;
+	printf("SWEET GPU: speed bin 0x%x (fuse 0x%08x): %u GPU levels, top %u MHz\n",
+	    bin, fuse, nlev, gpu_bins[b].mhz[nlev - 1]);
+	for (unsigned a = 0; a < 3; a++) {
+		int error = sweet_rpmh_arc_levels(arcs[a], lvl[a], MAX_GX_LEVELS, &num[a], &addr[a]);
+		if (error) {
+			printf("SWEET GPU: cmd-db %s: error %d\n", arcs[a], error);
+			return false;
+		}
+		/* The 0081 PDC TCS commands use 0x30000, 0x30010 and 0x30090 (KGSL, unnamed). */
+		printf("SWEET GPU: cmd-db %s addr 0x%05x%s, %u levels: %u %u %u %u %u %u %u %u %u %u %u %u\n",
+		    arcs[a], addr[a], (addr[a] == 0x30000 || addr[a] == 0x30010 || addr[a] == 0x30090) ?
+		    " (one of the PDC TCS addresses)" : " (NOT a PDC TCS address)", num[a],
+		    lvl[a][0], lvl[a][1], lvl[a][2], lvl[a][3], lvl[a][4], lvl[a][5],
+		    lvl[a][6], lvl[a][7], lvl[a][8], lvl[a][9], lvl[a][10], lvl[a][11]);
+	}
+	for (unsigned i = 0; i < nlev; i++) {
+		gx_vl[i] = gx_vlvl(gpu_bins[b].mhz[i]);
+		gx_khz[i] = gpu_bins[b].mhz[i] * 1000u;
+	}
+	cx_khz[0] = 0;
+	cx_khz[1] = 200000;
+	if (!arc_vote_tbl("GX", lvl[0], num[0], lvl[1], num[1], gx_vl, nlev, gx_votes) ||
+	    !arc_vote_tbl("CX", lvl[2], num[2], lvl[1], num[1], cx_vl, 2, cx_votes)) {
+		return false;
+	}
+	for (unsigned i = 0; i < nlev; i++) {
+		printf("SWEET GPU: GX level %u: %u MHz VLVL %u -> vote 0x%08x (gfx %u, mx %u)\n", i,
+		    gpu_bins[b].mhz[i], gx_vl[i], gx_votes[i], gx_votes[i] & 0xff, (gx_votes[i] >> 8) & 0xff);
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		printf("SWEET GPU: CX level %u: %u MHz VLVL %u -> vote 0x%08x\n", i, cx_khz[i] / 1000, cx_vl[i], cx_votes[i]);
+	}
+	gx_levels = nlev;                       /* only once every vote is valid */
+	return true;
+}
+
+/*
+ * The rest of hfi_start for v1 firmware with the HFI_USE_REG quirk:
+ * DCVS table, bandwidth table, then H2F_MSG_TEST ("no more HFI until the
+ * next boot"). The bandwidth table has no RPMh commands yet: KGSL's comes
+ * from the msm_bus BCM votes, so the GMU votes no DDR/CNOC bandwidth
+ * (the CPU's votes keep DDR up).
+ */
+static bool
+gpu_hfi_tables(uint32_t *ack)
+{
+	uint32_t m[BW_TBL_DW > PERF_TBL_DW ? BW_TBL_DW : PERF_TBL_DW];
+
+	if (gx_levels == 0 && !gpu_dcvs_votes()) {
+		return false;
+	}
+	bzero(m, sizeof(m));
+	m[0] = MSG_HDR(H2F_MSG_PERF_TBL, PERF_TBL_DW, 0);
+	m[1] = gx_levels;
+	m[2] = 2;
+	for (unsigned i = 0; i < gx_levels; i++) {
+		m[3 + 2 * i] = gx_votes[i];
+		m[4 + 2 * i] = gx_khz[i];
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		m[3 + 2 * MAX_GX_LEVELS + 2 * i] = cx_votes[i];
+		m[4 + 2 * MAX_GX_LEVELS + 2 * i] = cx_khz[i];
+	}
+	if (!hfi_cmd("H2F_MSG_PERF_TBL", m, PERF_TBL_DW, ack, 19)) {
+		return false;
+	}
+	bzero(m, sizeof(m));
+	m[0] = MSG_HDR(H2F_MSG_BW_VOTE_TBL, BW_TBL_DW, 0);
+	m[1] = 1;                               /* bw_level_num; cnoc/ddr cmds 0, wait masks 0 */
+	if (!hfi_cmd("H2F_MSG_BW_VOTE_TBL", m, BW_TBL_DW, ack, 19)) {
+		return false;
+	}
+	uint32_t test[2] = { MSG_HDR(H2F_MSG_TEST, 2, 0), 0 };
+	return hfi_cmd("H2F_MSG_TEST", test, 2, ack, 19);
+}
+
+/* a6xx_gmu_hfi_start, then the v1 hfi_start; true when every message was acknowledged. */
+static bool
+gpu_hfi_start(void)
+{
+	uint32_t ack[19];
+	bool done = false;
+
+	printf("SWEET GPU: starting HFI (HFI_CTRL_INIT)\n");
+	sweet_log_sync();
+	gpu_wr(gmu, GMU_HFI_CTRL_INIT, 1);
+	if (!gpu_poll(gmu, GMU_HFI_CTRL_STATUS_REG, 1, 1, GMU_START_TIMEOUT_US)) {
+		printf("SWEET GPU: HFI init failed: HFI_CTRL_STATUS 0x%08x\n", gpu_rd(gmu, GMU_HFI_CTRL_STATUS_REG));
+		gpu_smmu_cb_faults();
+		gpu_hfi_dump();
+		return false;
+	}
+	uint32_t ver = gpu_rd(gmu, GMU_HFI_VERSION_INFO);
+	printf("SWEET GPU: HFI up: HFI_CTRL_STATUS 0x%08x, HFI version 0x%08x (major %u minor %u branch %u)\n",
+	    gpu_rd(gmu, GMU_HFI_CTRL_STATUS_REG), ver, ver >> 28, (ver >> 5) & 0x7fffff, ver & 0x1f);
+	if ((ver >> 28) >= 2) {
+		printf("SWEET GPU: HFI v2 firmware; this driver speaks the a615-family v1 protocol only\n");
+		return false;
+	}
+
+	uint32_t init[5] = {
+		MSG_HDR(H2F_MSG_INIT, 5, 0), 0, GMU_VA_DUMP, GMEM_DUMP_SIZE, GMU_COLD_BOOT,
+	};
+	if (hfi_cmd("H2F_MSG_INIT", init, 5, ack, 19)) {
+		uint32_t fwver[2] = { MSG_HDR(H2F_MSG_FW_VER, 2, 0), GMU_FW_VERSION_1_8 };
+		if (hfi_cmd("H2F_MSG_FW_VER", fwver, 2, ack, 19)) {
+			printf("SWEET GPU: GMU firmware version 0x%08x: %u.%u step %u (KGSL wants 1.8)\n",
+			    ack[3], ack[3] >> 28, (ack[3] >> 16) & 0xfff, ack[3] & 0xffff);
+			done = gpu_hfi_tables(ack);
+			if (done) {
+				printf("SWEET GPU: HFI start complete (DCVS, BW, TEST acknowledged)\n");
+			}
+		}
+	}
+	gpu_smmu_cb_faults();
+	gpu_hfi_dump();
+	return done;
+}
+
+/* a6xx_gmu_oob_set for the a615 family. */
+static bool
+gmu_oob_set(unsigned req, const char *name)
+{
+	uint32_t set = 1u << (req + 16), check = 1u << (req + 24);
+
+	printf("SWEET GPU: OOB %s: set 0x%08x\n", name, set);
+	sweet_log_sync();
+	gpu_wr(gmu, GMU_HOST2GMU_INTR_SET, set);
+	bool ok = gpu_poll(gmu, GMU_GMU2HOST_INTR_INFO, check, check, GMU_START_TIMEOUT_US);
+	uint32_t info = gpu_rd(gmu, GMU_GMU2HOST_INTR_INFO);
+	gpu_wr(gmu, GMU_GMU2HOST_INTR_CLR, check);
+	printf("SWEET GPU: OOB %s: %s (INTR_INFO 0x%08x, RPMH_POWER_STATE 0x%x, SPTPRAC 0x%08x)\n", name,
+	    ok ? "acknowledged" : "TIMED OUT", info, gpu_rd(gmu, GMU_RPMH_POWER_STATE),
+	    gpu_rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS));
+	return ok;
+}
+
+/* a6xx_gmu_oob_clear for the a615 family. */
+static void
+gmu_oob_clear(unsigned req)
+{
+	gpu_wr(gmu, GMU_HOST2GMU_INTR_SET, 1u << (req + 24));
+}
+
+/* a6xx_gmu_gfx_rail_on: GX/MX ARC indices of the boot level, then the boot OOB. */
+static bool
+gpu_gx_rail_on(void)
+{
+	uint32_t vote = gx_votes[GX_BOOT_LEVEL];
+
+	gpu_wr(gmu, GMU_BOOT_SLUMBER_OPTION, OOB_BOOT_OPTION);
+	gpu_wr(gmu, GMU_GX_VOTE_IDX, vote & 0xff);
+	gpu_wr(gmu, GMU_MX_VOTE_IDX, (vote >> 8) & 0xff);
+	printf("SWEET GPU: GX rail on at level %u (%u MHz): gfx ARC %u, mx ARC %u\n",
+	    GX_BOOT_LEVEL, gx_khz[GX_BOOT_LEVEL] / 1000, vote & 0xff, (vote >> 8) & 0xff);
+	return gmu_oob_set(OOB_BOOT_SLUMBER, "boot_slumber (boot)");
+}
+
+/* a6xx_gmu_sptprac_enable / _disable (the a615 family has the SPTPRAC GDSC). */
+static bool
+gpu_sptprac(bool on)
+{
+	if (!on) {
+		gpu_wr(cc, GPUCC_GX_GDSCR, gpu_rd(cc, GPUCC_GX_GDSCR) | GX_GDSC_RETAIN_FF);
+	}
+	gpu_wr(gmu, GMU_GX_SPTPRAC_POWER_CONTROL, on ? SPTPRAC_POWERON_CTRL : SPTPRAC_POWEROFF_CTRL);
+	uint32_t want = on ? SPTPRAC_POWERON_STATUS : SPTPRAC_POWEROFF_STATUS;
+	bool ok = gpu_poll(gmu, GMU_SPTPRAC_PWR_CLK_STATUS, want, want, SPTPRAC_TIMEOUT_US);
+	printf("SWEET GPU: SPTPRAC power %s: %s (status 0x%08x)\n", on ? "on" : "off",
+	    ok ? "ok" : "TIMED OUT", gpu_rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS));
+	return ok;
+}
+
+/* a6xx_gmu_notify_slumber with HFI_USE_REG; the bus level is 0 (one-level BW table). */
+static void
+gpu_gx_slumber(void)
+{
+	gpu_sptprac(false);
+	gpu_wr(gmu, GMU_BOOT_SLUMBER_OPTION, OOB_SLUMBER_OPTION);
+	gpu_wr(gmu, GMU_GX_VOTE_IDX, GX_BOOT_LEVEL);
+	gpu_wr(gmu, GMU_MX_VOTE_IDX, 0);
+	bool ok = gmu_oob_set(OOB_BOOT_SLUMBER, "boot_slumber (slumber)");
+	gmu_oob_clear(OOB_BOOT_SLUMBER);
+	uint32_t state = gpu_rd(gmu, GMU_RPMH_POWER_STATE);
+	printf("SWEET GPU: slumber %s: RPMH_POWER_STATE 0x%x%s\n", ok ? "acknowledged" : "not acknowledged",
+	    state, state == GPU_HW_SLUMBER ? " (slumber)" : " (NOT slumber)");
+}
+
+/*
+ * _adreno_start's OOB around the first GPU register access: oob_gpu turns
+ * GX on; read the GX domain and the GPU core, then clear oob_gpu and the
+ * boot OOB as a successful start does, and send the GPU to slumber.
+ */
+static bool gpu_kept;
+
+static bool
+gpu_gx_test(bool zap, bool cp, bool run)
+{
+	uint32_t gx_gdscr;
+	int keep = 0;
+	PE_parse_boot_argn("sweetgpukeep", &keep, sizeof(keep));
+	sweet_scm_zap_keep = keep != 0 && run && cp;
+
+	if (gmu_oob_set(OOB_GPU, "gpu")) {
+		(void)gpu_report(&gx_gdscr);
+		gpu_report_gmu(gx_gdscr);
+		sweet_log_sync();
+		/* Match phone a6xx_start -> microcode_load order. SQE control stays
+		 * at cold zero through setup and the signed PAS test.
+		 */
+		if (cp && (gx_gdscr & GDSC_PWR_ON)) {
+			printf("SWEET GPU: CP pre-PAS cold setup (phone driver order)\n");
+			sweet_log_sync();
+			if (!gpu_cp_configure_cold()) {
+				printf("SWEET GPU: CP pre-PAS setup failed; retaining GX/GMU until reset\n");
+				sweet_log_sync();
+				return false;
+			}
+			if (run && !gpu_cp_start()) {
+				printf("SWEET GPU: CP start failed; retaining GX/GMU until reset\n");
+				sweet_log_sync();
+				return false;
+			}
+		}
+		sweet_scm_zap_running_hook = (run && cp) ? gpu_cp_secure_nop : NULL;
+		if (zap) {
+			if (!(gx_gdscr & GDSC_PWR_ON)) {
+				printf("SWEET GPU: zap skipped: GX not powered\n");
+				sweet_log_sync();
+			} else if (!sweet_scm_gpu_zap_test()) {
+				printf("SWEET GPU: zap operation not quiesced; retaining GX/GMU until reset\n");
+				sweet_log_sync();
+				return false;
+			}
+		}
+		if (run && cp && sweet_scm_zap_keep) {
+			/* sweetgpukeep=1: GX, GMU, zap and SQE stay up; sweet_gpu_run starts the keep-alive thread */
+			gpu_kept = true;
+			return true;
+		}
+		if (run && cp) {
+			/* back to the state the next run expects: SQE stopped */
+			vm_offset_t g = ml_io_map(GPU_PA, GPU_SIZE);
+			if (g) {
+				gpu_wr(g, A6XX_CP_SQE_CNTL * 4, 0);
+			}
+		}
+		if (!run && cp && (gx_gdscr & GDSC_PWR_ON) && !gpu_cp_post_pas_check()) {
+			printf("SWEET GPU: CP post-PAS state changed; retaining GX/GMU until reset\n");
+			sweet_log_sync();
+			return false;
+		}
+	}
+	gmu_oob_clear(OOB_GPU);
+	gmu_oob_clear(OOB_BOOT_SLUMBER);
+	gpu_gx_slumber();
+	(void)gpu_report(&gx_gdscr);
+	return true;
+}
+
+/* Nothing services the GMU after the test: put it back into reset. */
+static void
+gpu_gmu_reset(void)
+{
+	gpu_wr(gmu, GMU_CM3_SYSRESET, 1);
+	delay(10);
+	gpu_gmu_state("reset again");
+}
+
+/*
+ * Step 1 of the roadmap (sweetgpukeep=1 with sweetgpu=10): after the first CP test the GPU stays up (GX on, GMU
+ * running, zap not shut down, SQE running). A kernel thread repeats a NOP + CP_MEM_WRITE + CACHE_FLUSH_TS round every
+ * 15 s, six times, logs the state, then shuts everything down in the order the single-shot test used.
+ */
+static int gpu_keep_chan;
+
+static bool
+gpu_cp_repeat(unsigned round)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	volatile uint32_t *memwr = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF + CP_SCRATCH_MEMWR);
+	volatile uint32_t *ts = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF + CP_SCRATCH_TS);
+	const uint32_t memval = 0x5ee70000u + round, seq = 0x600d0000u + round;
+	*memwr = 0;
+	*ts = 0;
+	flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x200, TRUE);
+	cp_ring_emit(cp_pkt7(CP_NOP, 1));
+	cp_ring_emit(0);
+	cp_ring_emit(cp_pkt7(CP_MEM_WRITE, 3));
+	cp_ring_emit((uint32_t)(CP_SCRATCH_VA + CP_SCRATCH_MEMWR));
+	cp_ring_emit(0);
+	cp_ring_emit(memval);
+	cp_ring_emit(cp_pkt7(CP_EVENT_WRITE, 4));
+	cp_ring_emit(CACHE_FLUSH_TS | CP_EVENT_WRITE_IRQ);
+	cp_ring_emit((uint32_t)(CP_SCRATCH_VA + CP_SCRATCH_TS));
+	cp_ring_emit(0);
+	cp_ring_emit(seq);
+	cp_ring_flush(gpu);
+	bool idle = cp_ring_wait_idle(gpu, "KEEP round");
+	for (unsigned i = 0; i < 50000 && (*memwr != memval || *ts != seq); i++) {
+		flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x200, TRUE);
+		delay(1);
+	}
+	bool ok = idle && *memwr == memval && *ts == seq;
+	printf("SWEET GPU: KEEP round %u %s: memwr %#x (want %#x) ts %#x (want %#x) CP_IRQ %#x RBBM_STATUS %#x TRUST_CNTL %#x RPMH_POWER_STATE %#x\n",
+	    round, ok ? "PASSED" : "FAILED", *memwr, memval, *ts, seq, gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4),
+	    gpu_rd(gpu, A6XX_RBBM_STATUS * 4), gpu_rd(gpu, A6XX_RBBM_SECVID_TRUST_CNTL * 4), gpu_rd(gmu, GMU_RPMH_POWER_STATE));
+	sweet_log_sync();
+	return ok;
+}
+
+/*
+ * Roadmap step 2: a real indirect buffer. The main ring only holds CP_INDIRECT_BUFFER; the CP fetches the IB through the
+ * GPU SMMU from the scratch page (VA CP_SCRATCH_VA + 0x1000) and runs CP_MEM_WRITE, CP_REG_TO_MEM (reads the CP_RB_BASE
+ * register into memory, known value 0x40000000), CP_MEMCPY (copies the CP_MEM_WRITE result) and CACHE_FLUSH_TS.
+ * CP_MEMCPY (0x53) is the least certain opcode on the a618 SQE: if it is illegal it shows as CP_IRQ 0x80 and its own FAIL.
+ */
+#define CP_INDIRECT_BUFFER      63
+#define CP_REG_TO_MEM           62
+#define CP_MEMCPY               83
+#define CP_WAIT_MEM_WRITES      18
+#define CP_WAIT_FOR_IDLE        38
+#define CP_IB_OFF               0x1000u
+#define CP_IB_MEMWR             0x120u
+#define CP_IB_REG2MEM           0x130u
+#define CP_IB_MEMCPY            0x140u
+#define CP_IB_TS                0x150u
+
+static bool
+gpu_cp_ib_test(void)
+{
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		return false;
+	}
+	volatile uint32_t *ib = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF + CP_IB_OFF);
+	volatile uint32_t *res = (volatile uint32_t *)(cp_memory + CP_SCRATCH_OFF);
+	const uint32_t memval = 0x1b0a0001u, seq = 0x1b0b0001u, regval = 0x40000000u;
+	unsigned n = 0;
+	for (unsigned i = 0; i < 0x40; i++) {
+		res[CP_IB_MEMWR / 4 + i] = 0;
+	}
+	ib[n++] = cp_pkt7(CP_MEM_WRITE, 3);
+	ib[n++] = (uint32_t)(CP_SCRATCH_VA + CP_IB_MEMWR);
+	ib[n++] = 0;
+	ib[n++] = memval;
+	ib[n++] = cp_pkt7(CP_REG_TO_MEM, 3);
+	ib[n++] = (A6XX_CP_RB_BASE) | (1u << 18);
+	ib[n++] = (uint32_t)(CP_SCRATCH_VA + CP_IB_REG2MEM);
+	ib[n++] = 0;
+	ib[n++] = cp_pkt7(CP_WAIT_MEM_WRITES, 0);   /* the MEM_WRITE must land before MEMCPY reads it (run ib: MEMCPY copied 0) */
+	ib[n++] = cp_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ib[n++] = cp_pkt7(CP_MEMCPY, 5);
+	ib[n++] = 1;
+	ib[n++] = (uint32_t)(CP_SCRATCH_VA + CP_IB_MEMWR);
+	ib[n++] = 0;
+	ib[n++] = (uint32_t)(CP_SCRATCH_VA + CP_IB_MEMCPY);
+	ib[n++] = 0;
+	ib[n++] = cp_pkt7(CP_EVENT_WRITE, 4);
+	ib[n++] = CACHE_FLUSH_TS | CP_EVENT_WRITE_IRQ;
+	ib[n++] = (uint32_t)(CP_SCRATCH_VA + CP_IB_TS);
+	ib[n++] = 0;
+	ib[n++] = seq;
+	flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x2000, TRUE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cp_ring_emit(cp_pkt7(CP_INDIRECT_BUFFER, 3));
+	cp_ring_emit((uint32_t)(CP_SCRATCH_VA + CP_IB_OFF));
+	cp_ring_emit(0);
+	cp_ring_emit(n);
+	cp_ring_flush(gpu);
+	bool idle = cp_ring_wait_idle(gpu, "IB");
+	for (unsigned i = 0; i < 50000 && (res[CP_IB_TS / 4] != seq || res[CP_IB_MEMCPY / 4] != memval); i++) {
+		flush_dcache64((addr64_t)(cp_memory_pa + CP_SCRATCH_OFF), 0x200, TRUE);
+		delay(1);
+	}
+	bool wr = res[CP_IB_MEMWR / 4] == memval, r2m = res[CP_IB_REG2MEM / 4] == regval;
+	bool cpy = res[CP_IB_MEMCPY / 4] == memval, ts = res[CP_IB_TS / 4] == seq;
+	printf("SWEET GPU: IB test %s: MEM_WRITE %s (%#x), REG_TO_MEM %s (%#x want %#x), MEMCPY %s (%#x), CACHE_FLUSH_TS %s (%#x), CP_IRQ %#x, HW_FAULT %#x\n",
+	    (idle && wr && r2m && cpy && ts) ? "PASSED" : "FAILED", wr ? "ok" : "FAIL", res[CP_IB_MEMWR / 4],
+	    r2m ? "ok" : "FAIL", res[CP_IB_REG2MEM / 4], regval, cpy ? "ok" : "FAIL", res[CP_IB_MEMCPY / 4],
+	    ts ? "ok" : "FAIL", res[CP_IB_TS / 4], gpu_rd(gpu, A6XX_CP_INTERRUPT_STATUS * 4), gpu_rd(gpu, A6XX_CP_HW_FAULT * 4));
+	sweet_log_sync();
+	return idle && wr && r2m && cpy && ts;
+}
+
+static void
+gpu_keep_thread(void *arg, wait_result_t result)
+{
+	const unsigned rounds = 6;
+	unsigned passed = 0;
+	bool ib_ok = false;
+	(void)arg;
+	(void)result;
+	for (unsigned r = 1; r <= rounds; r++) {
+		uint64_t deadline;
+		clock_interval_to_deadline(15, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&gpu_keep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (r == 1) {
+			ib_ok = gpu_cp_ib_test();
+		}
+		if (gpu_cp_repeat(r)) {
+			passed++;
+		} else {
+			break;
+		}
+	}
+	printf("SWEET GPU: KEEP %u of %u rounds passed, IB test %s; shutting the GPU down\n", passed, rounds, ib_ok ? "PASSED" : "FAILED");
+	sweet_log_sync();
+	bool zap = sweet_scm_zap_shutdown();
+	vm_offset_t g = ml_io_map(GPU_PA, GPU_SIZE);
+	if (g) {
+		gpu_wr(g, A6XX_CP_SQE_CNTL * 4, 0);
+	}
+	gmu_oob_clear(OOB_GPU);
+	gmu_oob_clear(OOB_BOOT_SLUMBER);
+	gpu_gx_slumber();
+	gpu_gmu_reset();
+	printf("SWEET GPU: KEEP shutdown done (zap %s)\n", zap ? "complete" : "failed");
+	sweet_log_sync();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_keep_start(void)
+{
+	thread_t thread;
+	printf("SWEET GPU: KEEP: GPU left up after the first test, rounds every 15 s\n");
+	sweet_log_sync();
+	if (kernel_thread_start(gpu_keep_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU: KEEP: kernel_thread_start failed; GPU stays up until reset\n");
+	}
+}
+
+/* Cold boot; with hold, the GMU is put back into reset after reporting. */
+static bool
+gpu_gmu_boot(bool hold)
+{
+	DTEntry node;
+	uint32_t const *fw = NULL;
+	unsigned int size = 0, bad = 0;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "gmu-firmware", (void const **)&fw, &size) != kSuccess) {
+		printf("SWEET GPU: no /sweet-gpu gmu-firmware in the device tree; GMU not booted\n");
+		return false;
+	}
+	if (size == 0 || size > 2 * GMU_TCM_SIZE || (size & 3)) {
+		printf("SWEET GPU: gmu-firmware size %u invalid (max 0x%x)\n", size, 2 * GMU_TCM_SIZE);
+		return false;
+	}
+	if (gpu_rd(gmu, GMU_CM3_SYSRESET) != 1) {
+		printf("SWEET GPU: GMU core not held in reset; not booted\n");
+		return false;
+	}
+	gpu_smmu_faults();
+	gpu_wr(gmu, GMU_GENERAL_7_REG, 1);                     /* TCM retention */
+	if (!gpu_gmu_rpmh_ucode()) {
+		return false;
+	}
+	/* _load_legacy_gmu_fw: raw image from ITCM_START, running on into DTCM. */
+	for (unsigned i = 0; i < size / 4; i++) {
+		gpu_wr(gmu, GMU_ITCM + 4 * i, fw[i]);
+	}
+	for (unsigned i = 0; i < size / 4; i++) {
+		bad += gpu_rd(gmu, GMU_ITCM + 4 * i) != fw[i];
+	}
+	printf("SWEET GPU: GMU firmware %u bytes loaded, %u words differ on readback\n", size, bad);
+	if (bad) {
+		return false;
+	}
+	gpu_wr(gmu, GMU_CM3_FW_INIT_RESULT, 0);
+	gpu_wr(gmu, GMU_CM3_BOOT_CONFIG, GMU_TCM_BOOT);
+	gpu_wr(gmu, GMU_HFI_QTBL_ADDR, GMU_VA_HFI);
+	gpu_wr(gmu, GMU_HFI_QTBL_INFO, 1);
+	gpu_wr(gmu, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE_MASK);
+	gpu_wr(gmu, GMU_CM3_CFG_REG, 0x4052);                  /* reset value, no NMI */
+	gpu_wr(gmu, GMU_HFI_SFR_ADDR, GMU_CHIPID);
+	gpu_wr(gmu, GMU_PWR_COL_CP_MSG, GMU_VA_LOG | 0);       /* log: one 4 KiB unit */
+	/* a6xx_gmu_power_config, idle level ACTIVE: caches off, RPMh client on. */
+	gpu_wr(gmu, GMU_SYS_BUS_CONFIG, 1);
+	gpu_wr(gmu, GMU_ICACHE_CONFIG, 1);
+	gpu_wr(gmu, GMU_DCACHE_CONFIG, 1);
+	gpu_wr(gmu, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	gpu_wr(gmu, GMU_RPMH_CTRL, gpu_rd(gmu, GMU_RPMH_CTRL) | GMU_RPMH_ENABLE_MASK);
+	gpu_gmu_state("before start");
+	sweet_log_sync();
+
+	/* a6xx_gmu_start */
+	gpu_wr(gmu, GMU_CX_GMU_WFI_CONFIG, 0);
+	gpu_wr(gmu, GMU_CM3_SYSRESET, 0);
+	uint64_t t0 = mach_absolute_time();
+	bool booted = gpu_poll(gmu, GMU_CM3_FW_INIT_RESULT, 0xffffffffu, GMU_BOOT_DONE, GMU_START_TIMEOUT_US);
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET GPU: GMU %s after %llu us\n", booted ? "BOOTED (0xBABEFACE)" : "did not boot", ns / 1000);
+	gpu_gmu_state("after start");
+	gpu_smmu_faults();
+	sweet_log_sync();
+
+	if (hold) {
+		gpu_gmu_reset();
+	}
+	return booted;
+}
+
+static void
+sweet_gpu_run(void)
+{
+	int mode = 1;
+	uint32_t gx_gdscr;
+
+	/* Poco X3 NFC only: the Poco F1 has its own Adreno 630 driver (sweet_a630.c) */
+	if (!sweet_board_surya()) {
+		return;
+	}
+	PE_parse_boot_argn("sweetgpu", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	cc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (gcc == 0 || cc == 0) {
+		printf("SWEET GPU: GCC/GPU CC map failed\n");
+		return;
+	}
+	bool cx_up = gpu_report(&gx_gdscr);
+	if (mode >= 2 && !cx_up) {
+		if (!gpu_power_cx()) {
+			printf("SWEET GPU: CX power-up failed; GMU not read\n");
+			return;
+		}
+		cx_up = gpu_report(&gx_gdscr);
+	}
+	if (!cx_up) {
+		printf("SWEET GPU: CX domain unpowered or unclocked; GMU not read\n");
+		return;
+	}
+	gpu_report_gmu(gx_gdscr);
+	if (mode >= 2 && gmu != 0) {
+		gpu_smmu_probe();
+		gpu_tcm_test();
+	}
+	if (mode == 3 && gmu != 0) {
+		gpu_gmu_boot(true);
+	}
+	/* KGSL order: GMU memory and IOMMU at probe, HFI table, then the boot. */
+	if (mode >= 4 && gmu != 0 && gpu_gmem_alloc()) {
+		int smmu = gpu_smmu_setup();
+		if (smmu == SMMU_FAILED || (smmu == SMMU_UNROUTED && mode != 5)) {
+			printf("SWEET GPU: GMU not booted (sweetgpu=5 boots it without a routed SMR)\n");
+			return;
+		}
+		if (mode >= 8 && !gpu_cp_memory_setup()) {
+			printf("SWEET GPU: CP memory setup failed; GPU test stopped\n");
+			sweet_log_sync();
+			return;
+		}
+		/* sweetgpu=6: KGSL has the DCVS votes from probe; GX rail and SPTPRAC precede HFI. */
+		if (mode >= 6 && !gpu_dcvs_votes()) {
+			printf("SWEET GPU: no DCVS votes; GMU not booted\n");
+			return;
+		}
+		gpu_hfi_table();
+		bool booted = gpu_gmu_boot(false);
+		bool rail = false, gx = false;
+		if (booted && mode >= 6) {
+			rail = gpu_gx_rail_on();
+			gx = rail && gpu_sptprac(true);
+		}
+		if (booted && (mode < 6 || gx) && gpu_hfi_start() && mode >= 6) {
+			if (!gpu_gx_test(mode >= 7, mode >= 9, mode >= 10)) {
+				return;
+			}
+			if (gpu_kept) {
+				gpu_keep_start();
+				return;
+			}
+		} else if (rail) {
+			/* GX was voted on but the start did not complete: power it down again. */
+			gmu_oob_clear(OOB_BOOT_SLUMBER);
+			gpu_gx_slumber();
+		}
+		gpu_gmu_reset();
+		sweet_log_sync();
+	}
+}
+
+/*
+ * Entry from sweet_ufs.c at early boot. boot-arg sweetgpudelay=N (seconds) defers the whole probe to a kernel
+ * thread: the USB Ethernet log only comes up ~30 s after the kernel starts, and its earlier lines are lost.
+ */
+static int sweet_gpu_sleep_chan;
+
+static void
+sweet_gpu_thread(void *arg, wait_result_t result)
+{
+	uint64_t deadline;
+	(void)result;
+	clock_interval_to_deadline((uint32_t)(uintptr_t)arg, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&sweet_gpu_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	sweet_scm_probe();
+	sweet_gpu_run();
+	sweet_log_sync();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int delay_s = 0;
+
+	/* Poco X3 NFC only: the Poco F1 has its own Adreno 630 driver (sweet_a630.c) */
+	if (!sweet_board_surya()) {
+		return;
+	}
+	PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 0) {
+		thread_t thread;
+		printf("SWEET GPU: probe deferred by %d s (sweetgpudelay)\n", delay_s);
+		if (kernel_thread_start(sweet_gpu_thread, (void *)(uintptr_t)delay_s, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			return;
+		}
+		printf("SWEET GPU: kernel_thread_start failed; probing now\n");
+	}
+	sweet_scm_probe();
+	sweet_gpu_run();
+}
