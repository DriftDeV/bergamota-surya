+/*
+ * SWEET: Adreno 618 GPU bring-up.
+ *
+ * The GPU (chipid 0x06010800, the A618 of sc7180) sits at 0x05000000 with
+ * its GMU (Cortex-M3 power manager) at 0x0506a000; its clocks and the CX
+ * and GX power domains come from the GPU clock controller at 0x05090000
+ * (offsets from the phone's LineageOS 4.14 gpucc/gcc-sdmmagpie.c, GDSCs
+ * from the live DT). The GPU CC block itself is clocked by
+ * GCC_GPU_CFG_AHB_CLK. ABL leaves the whole GPU off (0078: both GDSCs
+ * collapsed, every GPU CC branch off but cxo_aon).
+ *
+ *   sweetgpu=0  nothing
+ *   sweetgpu=1  read-only probe (default): reads each block only when the
+ *               status registers say its power domain and clocks are on
+ *               (an access to a gated block would hang)
+ *   sweetgpu=2  probe, then power the CX domain and the GMU clocks as
+ *               downstream gdsc_enable + a6xx GMU resume do, and probe again;
+ *               then dump the GPU SMMU (read-only) and test GMU ITCM/DTCM
+ *               writes while the GMU Cortex-M3 is held in reset
+ *   sweetgpu=3  2, then cold-boot the GMU firmware (ADT /sweet-gpu
+ *               gmu-firmware, tools/mkadt.py) as the phone's KGSL
+ *               a6xx_gmu_fw_start does, wait for 0xBABEFACE, report, and
+ *               hold the GMU in reset again. The SMMU is left as ABL left it
+ *               (every stream faults), so the GMU cannot reach RAM: the
+ *               global fault registers show what it tried to access.
+ *   sweetgpu=4  2, then give the GMU its memory (GPU SMMU context bank 0
+ *               with a static page table for the uncached buffers KGSL
+ *               allocates: dummy page, HFI queues, crash dump, log), the HFI
+ *               queue table, cold-boot it, start HFI and exchange the first
+ *               messages (H2F_MSG_INIT, H2F_MSG_FW_VER), then hold the GMU
+ *               in reset again. Stops before the boot when the SMR that
+ *               routes the GMU stream IDs does not read back valid (0083:
+ *               it read 0 and the phone reset without a panic soon after
+ *               the boot, before the next log flush).
+ *               After H2F_MSG_FW_VER the rest of the v1 hfi_start follows:
+ *               the GX/CX DCVS table (cmd-db ARC levels, fused speed bin),
+ *               a bandwidth table without RPMh commands, H2F_MSG_TEST.
+ *   sweetgpu=5  4, but goes on without a valid SMR, to reproduce that reset;
+ *               the console log is flushed (sweet_log_sync) before each step.
+ *   sweetgpu=6  4 with GX: the boot OOB turns on the GX rail at 180 MHz
+ *               (a6xx_gmu_gfx_rail_on) and SPTPRAC before HFI; after HFI
+ *               the oob_gpu request, the GX domain and GPU core registers
+ *               are read, then the GPU is sent to slumber.
+ *   sweetgpu=7  6 with a signed zap PAS load/auth/shutdown test while GX is
+ *               on (requires sweetscm=4). No CP commands are submitted.
+ *   sweetgpu=8  7 plus CP buffers, original SQE firmware, and SID0/CB1 tables;
+ *               readback and software walks only (DT disables ATOS).
+ *   sweetgpu=9  8 plus cold CP ring/SQE register setup before the PAS test;
+ *               SQE control stays at initial zero; no commands submitted.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include <arm/caches_internal.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
