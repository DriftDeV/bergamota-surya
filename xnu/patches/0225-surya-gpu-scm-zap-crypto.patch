+#ifndef _BSD_DEV_SWEET_RPMH_H_
+#define _BSD_DEV_SWEET_RPMH_H_
+#include <sys/types.h>
+
+/* Raw cmd-db BCM auxiliary data; validate before using it to compute votes. */
+struct sweet_rpmh_bcm {
+	uint32_t address;
+	uint32_t unit;
+	uint16_t width;
+	uint8_t vcd;
+	uint8_t reserved;
+	uint16_t version;
+};
+
+/* Read-only lookup: no RPMh votes or TCS register writes. */
+int sweet_rpmh_bcm_info(const char *res, struct sweet_rpmh_bcm *info);
+/* Board crypto -> DDR ACTIVE vote, retained for this boot; no release API. */
